<?xml version="1.0" encoding="utf-8"?>
<!-- On Android 8+ the launcher icon becomes adaptive: the launcher masks it
     into circles, squircles or whatever the OEM fancies — fitting, for an
     app whose own dial can be a triangle. Older devices keep the plain
     vector in drawable/. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
