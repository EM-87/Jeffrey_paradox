<?xml version="1.0" encoding="utf-8"?>
<!-- One picture: the sky's own token with whatever is in front of it, and
     the temperature under it. Everything on it is drawn by the app rather
     than laid out here, for the same reason the clock widget's digital
     half is a bitmap: a RemoteViews layout can hold a number and cannot
     hold a moon with a cloud across it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_weather_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_weather_label" />

    <!-- Ask again where we are.

         A weather widget with no way to say "I have moved" is a widget
         that is wrong in a new city until somebody thinks to open the
         app, which is the thing a widget exists to save you. It refreshes
         the reading and every other widget with it — see
         [WeatherWidgetProvider]. -->
    <ImageView
        android:id="@+id/widget_weather_locate"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:alpha="0.55"
        android:contentDescription="@string/widget_weather_locate"
        android:padding="4dp"
        android:src="@drawable/ic_widget_locate" />

</FrameLayout>
