<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <com.em87.weirdclock.ClockView
        android:id="@+id/clock_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.6"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_settings" />

    <!-- Banner shown while setting an alarm time by winding the hands. -->
    <LinearLayout
        android:id="@+id/alarm_set_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/set_alarm_time"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/alarm_set_confirm"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text="@string/alarm_set_confirm" />

        <Button
            android:id="@+id/alarm_set_cancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="52dp"
            android:text="@string/alarm_set_cancel" />
    </LinearLayout>

    <!-- World-clock bubbles float here: draggable mini dials with bubble
         physics, bouncing off the screen edges, each other and the main
         dial. Populated in code from the selected cities. -->
    <FrameLayout
        android:id="@+id/bubble_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Single centered mode button: hourglass on the clock, analog clock
         on the stopwatch. Start/reset live on the drawn case pushers. -->
    <Button
        android:id="@+id/mode_button"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="@string/mode_clock" />

</FrameLayout>
