<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing but the dial.

     There was a gear in the corner for a version. It is the launcher's
     job: a long press on any widget brings up a popup with a bin in it,
     and the ones that can be reconfigured put a gear beside it. Drawing
     our own meant a control sitting on a clock face all day for the sake
     of a thing you set once — and in a place nobody looks for it.

     The frame stays because the widget is more than its clock now: see
     widget_info.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <AnalogClock
        android:id="@+id/widget_analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/widget_dial"
        android:hand_hour="@drawable/widget_hand_hour"
        android:hand_minute="@drawable/widget_hand_minute"
        android:hand_second="@drawable/widget_hand_second" />

    <!-- The same widget on the face with no hands. One of the two is
         hidden whenever the widget is built, rather than a second provider
         with a second entry in the launcher's list: it is one clock, and
         somebody who chose digits should not have to find and place a
         different widget to stop looking at a dial.

         The system's AnalogClock ticks itself for nothing; this is a
         bitmap and has to be repainted, so it says only as much as it can
         afford to — see ClockWidgetProvider. -->
    <ImageView
        android:id="@+id/widget_digital_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/a11y_clock"
        android:visibility="gone" />

</FrameLayout>
