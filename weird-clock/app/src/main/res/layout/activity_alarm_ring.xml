<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Bell for an alarm, stopwatch for a finished countdown: set in code,
         because this one screen serves both. -->
    <TextView
        android:id="@+id/ring_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="72sp" />

    <!-- Counts up from the moment it went off, not the time of day. When a
         timer catches you mid-something, what you need off this screen is
         how far past it you already are. -->
    <Chronometer
        android:id="@+id/alarm_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/ring_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarm_ringing"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/snooze_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:minWidth="200dp"
        android:text="@string/alarm_snooze"
        android:textSize="20sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/stop_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minWidth="200dp"
        android:text="@string/alarm_stop"
        android:textSize="20sp" />

</LinearLayout>
