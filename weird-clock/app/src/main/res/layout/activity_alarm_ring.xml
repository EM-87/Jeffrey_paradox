<?xml version="1.0" encoding="utf-8"?>
<!-- A ScrollView, because of the keyboard. With a sum on screen the
     numeric keypad covers the bottom third, and the button that stops the
     alarm was under it: the only way to reach it was to dismiss the
     keyboard first, at six in the morning, with the bells going. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Bell for an alarm, stopwatch for a finished countdown: set in code,
         because this one screen serves both. -->
    <TextView
        android:id="@+id/ring_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_bell_glyph"
        android:contentDescription="@string/a11y_ringing"
        android:textSize="72sp" />

    <!-- Counts up from the moment it went off, not the time of day. When a
         timer catches you mid-something, what you need off this screen is
         how far past it you already are. -->
    <Chronometer
        android:id="@+id/alarm_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/ring_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarm_ringing"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <!-- Big, and the first thing under a hand that swats at the screen:
         hitting snooze half asleep is not a failure, it is the point of
         snooze. -->
    <Button
        android:id="@+id/snooze_button"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="28dp"
        android:text="@string/alarm_snooze"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- Stopping is the one that must not happen by accident, so it takes a
         gesture the length of the screen instead of a tap. -->
    <com.em87.weirdclock.SlideToStopView
        android:id="@+id/stop_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp" />

    <!-- And when a mission has been asked for, it takes its place: the two
         are never both on screen, or the mission would be decoration. -->
    <LinearLayout
        android:id="@+id/mission_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/mission_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="40sp" />

        <EditText
            android:id="@+id/mission_answer"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints=""
            android:gravity="center"
            android:hint="@string/mission_answer_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="numberSigned"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <Button
            android:id="@+id/mission_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/mission_check"
            android:textSize="22sp" />

    </LinearLayout>

</LinearLayout>

</ScrollView>
