<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Clock mode: C1 clock → C2 alarms → C3 calendar. -->
    <FrameLayout
        android:id="@+id/calendar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.em87.weirdclock.CalendarPageView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </FrameLayout>

    <!-- Chronograph mode: S1 stopwatch → S2 countdown → S3 hourglass.
         The countdown as real falling sand under the accelerometer; the
         neck decides how many grains pass. Flip the phone to turn it over. -->
    <FrameLayout
        android:id="@+id/hourglass_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.em87.weirdclock.SandHourglassView
            android:id="@+id/s3_sand"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Duration presets: one selectable at a time; picking one pours
             the matching amount of sand into the glass. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/s3_duration_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            app:singleSelection="true"
            app:selectionRequired="false">

            <Button
                android:id="@+id/s3_d3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="3′" />

            <Button
                android:id="@+id/s3_d5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="5′" />

            <Button
                android:id="@+id/s3_d10"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="10′" />

            <Button
                android:id="@+id/s3_d15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="15′" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>

</FrameLayout>
