<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Clock mode: C1 clock → C2 alarms → C3 calendar. -->
    <FrameLayout
        android:id="@+id/calendar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.em87.weirdclock.CalendarPageView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </FrameLayout>

    <!-- Chronograph mode: S1 stopwatch → S2 countdown → S3 hourglass.
         The countdown as real falling sand under the accelerometer; the
         neck decides how many grains pass. Flip the phone to turn it over. -->
    <FrameLayout
        android:id="@+id/hourglass_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.em87.weirdclock.SandHourglassView
            android:id="@+id/s3_sand"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/s3_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </FrameLayout>

</FrameLayout>
