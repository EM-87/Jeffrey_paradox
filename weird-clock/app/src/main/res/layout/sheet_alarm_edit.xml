<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm editor: a bottom sheet with the time up top (tap to wind it on
     the dial), the weekday strip, then the options, then delete and save in
     opposite corners. -->
<!-- A NestedScrollView and not a plain ScrollView, which is the whole
     difference between a sheet you can scroll and a sheet you can only
     close. A bottom sheet decides whether a downward drag belongs to the
     content or to itself by asking the content, through the nested
     scrolling protocol — and a plain ScrollView does not speak it. So the
     sheet never heard "I still have room to scroll up", took every
     downward drag for itself, and once you had scrolled down the only
     thing left to do was close it. With enough rows on an alarm that
     meant the time at the top became unreachable. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- One dial per time this concept happens: tap one to wind it,
                 hold it to drop it, + for another (four at most). -->
            <LinearLayout
                android:id="@+id/sheet_dials"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <!-- A plus, not a word: the dials need the room. -->
            <Button
                android:id="@+id/sheet_add_time"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/alarm_add_time"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Weekday buttons: S M T W T F S, tapped individually. -->
        <LinearLayout
            android:id="@+id/sheet_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheet_weekdays"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_weekdays"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sheet_weekends"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_weekends"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sheet_everyday"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_everyday"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/text_secondary"
            android:alpha="0.25" />

        <!-- Name -->
        <LinearLayout
            android:id="@+id/sheet_row_name"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_label_title" />

            <TextView
                android:id="@+id/sheet_name_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Notes: the same field the calendar's events have, so the dial
             can read an alarm out to the same depth as an appointment. -->
        <LinearLayout
            android:id="@+id/sheet_row_notes"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/reminder_notes" />

            <TextView
                android:id="@+id/sheet_notes_value"
                style="@style/AlarmSheetRowValue"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Sound -->
        <LinearLayout
            android:id="@+id/sheet_row_sound"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_sound_title" />

            <TextView
                android:id="@+id/sheet_sound_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Duration: above zero it also becomes a dated calendar event. -->
        <LinearLayout
            android:id="@+id/sheet_row_duration"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/reminder_duration" />

            <TextView
                android:id="@+id/sheet_duration_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Vibration -->
        <LinearLayout style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_vibrate" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sheet_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- The torch, which is a property of the morning and not of the
             app: the alarm that has to get you out of bed can have the room
             lit, and the one about the bread does not need a lighthouse. -->
        <LinearLayout style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_flash" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sheet_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Snooze -->
        <LinearLayout
            android:id="@+id/sheet_row_snooze"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_snooze" />

            <TextView
                android:id="@+id/sheet_snooze_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Only worth asking once there is a snooze to limit, so it is not
             here until there is one. Its own row rather than a number tucked
             into the one above, because "every ten minutes" and "three times
             and then get up" are two different decisions. -->
        <LinearLayout
            android:id="@+id/sheet_row_snooze_limit"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/pref_snooze_limit_title" />

            <TextView
                android:id="@+id/sheet_snooze_limit_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Gentle wake: this alarm's screen comes up rather than switching
             on. Per alarm, because a sunrise belongs to the one that wakes
             you and not to the reminder about the bread. -->
        <LinearLayout
            android:id="@+id/sheet_gentle_row"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_gentle" />

            <TextView
                android:id="@+id/sheet_gentle_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Last, because it is the last thing the alarm asks. Everything
             above is how it wakes you; this is what it takes to make it
             stop. -->
        <LinearLayout
            android:id="@+id/sheet_mission_row"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_mission" />

            <TextView
                android:id="@+id/sheet_mission_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheet_delete"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_delete" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/sheet_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_save" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
