<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm editor: a bottom sheet with the time up top (tap to wind it on
     the dial), the weekday strip, then the options, then delete and save in
     opposite corners. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- One dial per time this concept happens: tap one to wind
                 it, Add for another (three at most). -->
            <LinearLayout
                android:id="@+id/sheet_dials"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <Button
                android:id="@+id/sheet_add_time"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_add_time" />
        </LinearLayout>

        <!-- Weekday buttons: S M T W T F S, tapped individually. -->
        <LinearLayout
            android:id="@+id/sheet_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheet_weekdays"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_weekdays"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sheet_weekends"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_weekends"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sheet_everyday"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/alarm_quick_everyday"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/text_secondary"
            android:alpha="0.25" />

        <!-- Name -->
        <LinearLayout
            android:id="@+id/sheet_row_name"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_label_title" />

            <TextView
                android:id="@+id/sheet_name_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Sound -->
        <LinearLayout
            android:id="@+id/sheet_row_sound"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/pref_bell_style_title" />

            <TextView
                android:id="@+id/sheet_sound_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Snooze -->
        <LinearLayout
            android:id="@+id/sheet_row_snooze"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_snooze" />

            <TextView
                android:id="@+id/sheet_snooze_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Duration: above zero it also becomes a dated calendar event. -->
        <LinearLayout
            android:id="@+id/sheet_row_duration"
            style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/reminder_duration" />

            <TextView
                android:id="@+id/sheet_duration_value"
                style="@style/AlarmSheetRowValue" />
        </LinearLayout>

        <!-- Vibration -->
        <LinearLayout style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_vibrate" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sheet_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Flash -->
        <LinearLayout style="@style/AlarmSheetRow">

            <TextView
                style="@style/AlarmSheetRowTitle"
                android:text="@string/alarm_flash" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sheet_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sheet_delete"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_delete" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/sheet_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_save" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
