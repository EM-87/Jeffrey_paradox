<?xml version="1.0" encoding="utf-8"?>
<!-- One swipe left of the clock: the calendar. Nothing below it —
     the stopwatch moved next door to the countdown — and the weather
     above it, which is not swiped to at all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <FrameLayout
        android:id="@+id/calendar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.em87.weirdclock.CalendarPageView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <!-- And, on the face that is already a picture of where the earth
             is, the rest of the family instead of a grid of days. The
             dial is the host because the dial owns the sky, the winding
             and every gesture that reaches a planet; it simply is not
             being a clock here — see ClockView.skyOnly. -->
        <com.em87.weirdclock.ClockView
            android:id="@+id/orrery_card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The weather, behind the sky token on the dial. Above the month in
         the grid of cards, which is to say on this page and on the top
         row: shown when that row is the one in use and gone otherwise,
         like every other card. The button under it is the one every
         card but the clock has: straight back to the clock. -->
    <FrameLayout
        android:id="@+id/weather_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.em87.weirdclock.WeatherCardView
            android:id="@+id/weather_card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/weather_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:alpha="0.75"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_clock"
            android:src="@drawable/ic_clock_face" />
    </FrameLayout>

    <!-- The toolbox, again.
         There is one on the clock's own page and it could not reach this
         one: the button is found by id inside the page it is on, so the
         card that is nothing but sky had planets on its floor and nothing
         anywhere to pick them up with. Same id, same handler, one per
         page. -->
    <ImageButton
        android:id="@+id/reassemble_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:alpha="0.6"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/pref_reassemble_title"
        android:src="@drawable/ic_toolbox"
        android:visibility="gone" />

</FrameLayout>
