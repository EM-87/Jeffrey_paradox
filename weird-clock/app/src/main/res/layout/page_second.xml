<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Clock mode: swipe left from the clock reaches the alarms. -->
    <include
        android:id="@+id/alarms_container"
        layout="@layout/page_alarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chronograph mode: the same swipe reaches the countdown dial. -->
    <FrameLayout
        android:id="@+id/countdown_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.em87.weirdclock.ClockView
            android:id="@+id/countdown_clock_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="#8A93A8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/countdown_start_pause"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chrono_start" />

            <Button
                android:id="@+id/countdown_reset"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chrono_reset" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
