<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Clock mode: swipe left from the clock reaches the alarms. -->
    <include
        android:id="@+id/alarms_container"
        layout="@layout/page_alarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chronograph mode: the same swipe reaches the countdown dial. -->
    <FrameLayout
        android:id="@+id/countdown_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Case pushers are the chrono controls; the only screen button
             returns straight to the clock. -->
        <com.em87.weirdclock.ClockView
            android:id="@+id/countdown_clock_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />

        <Button
            android:id="@+id/countdown_back_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="@string/mode_stopwatch" />
    </FrameLayout>

</FrameLayout>
