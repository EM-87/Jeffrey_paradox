<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Clock mode: swipe left from the clock reaches the alarms. -->
    <include
        android:id="@+id/alarms_container"
        layout="@layout/page_alarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chronograph mode: the same swipe reaches the countdown dial. -->
    <FrameLayout
        android:id="@+id/countdown_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- No bottom controls: the drawn case pushers are the interface. -->
        <com.em87.weirdclock.ClockView
            android:id="@+id/countdown_clock_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />
    </FrameLayout>

</FrameLayout>
