<?xml version="1.0" encoding="utf-8"?>
<!-- One swipe right of home. Clock mode: C1, the alarms.
     Chronograph mode: S1, the countdown dial. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <include
        android:id="@+id/alarms_container"
        layout="@layout/page_alarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/countdown_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.em87.weirdclock.ClockView
            android:id="@+id/countdown_clock_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />

        <!-- Straight home to the clock, no stop at the hourglass. -->
        <ImageButton
            android:id="@+id/countdown_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.75"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_clock"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_clock_face" />
    </FrameLayout>

</FrameLayout>
