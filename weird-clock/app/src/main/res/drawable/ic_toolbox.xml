<!-- A spanner and a screwdriver, side by side and leaning apart.

     Crossed is how a workshop draws it and twice now it has not survived
     being drawn at twenty-four density-independent pixels. Two solid
     shapes laid over one another have nothing between them, so the eye
     gets one lump with a diagonal in it; and a vector drawable cannot
     punch a hole through one shape with another, which was the second
     attempt and came out as the same lump.

     So they stand apart, leaning away from each other, with a clear
     channel of background between them from top to bottom. Nothing
     overlaps anything, which means there is nothing to resolve: the eye
     sees two objects, and each has one feature that names it — a ring at
     the head of the spanner, a fat handle and a flat blade on the
     screwdriver.

     It sits opposite the gear because the two are the same kind of thing —
     a way out of the clock — and a lone button in a corner with nothing
     across from it reads as a mistake. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- The spanner, leaning left. Pivoted low so the heads splay and the
         tails stay together, the way two tools stood in a jar do. -->
    <group
        android:pivotX="7"
        android:pivotY="21"
        android:rotation="-11">

        <!-- A ring head: two circles in one path, so the inside is a hole
             rather than another shape sitting on top of it. -->
        <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M7,5.4 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 M7,5.4 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

        <!-- And the shaft, finishing round. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M5.7,8.0 L8.3,8.0 L8.3,20.7 A1.3,1.3 0 0 1 5.7,20.7 Z" />

    </group>

    <!-- The screwdriver, leaning right. -->
    <group
        android:pivotX="17"
        android:pivotY="21"
        android:rotation="11">

        <!-- The handle: the fattest thing in the icon, which is what says
             screwdriver before any of the rest of it is read. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15,3.4 A1.3,1.3 0 0 1 16.3,2.1 L17.7,2.1 A1.3,1.3 0 0 1 19,3.4 L19,8.9 L15,8.9 Z" />

        <!-- The collar, then the shaft, then a blade wider than the shaft
             and flat across the end. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15.5,8.9 L18.5,8.9 L18.5,10.5 L15.5,10.5 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M16.4,10.5 L17.6,10.5 L17.6,18.4 L16.4,18.4 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15.7,18.4 L18.3,18.4 L18.3,21.4 L15.7,21.4 Z" />

    </group>

</vector>
