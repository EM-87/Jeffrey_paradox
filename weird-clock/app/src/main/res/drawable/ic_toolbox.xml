<!-- A spanner and a screwdriver crossed: the mark every workshop uses, and
     the only thing on this dial that undoes a mess rather than making one.
     It sits opposite the gear because the two are the same kind of thing —
     a way out of the clock — and a lone button in a corner with nothing
     across from it reads as a mistake. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- The spanner: an open jaw at the top left, running down to the right. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.9,3.2c-1.9,-0.5 -3.9,0 -5.3,1.4c-1.5,1.5 -2,3.7 -1.3,5.7l2.6,-2.6l2.5,0.7l0.7,2.5l-2.6,2.6c1.9,0.7 4.2,0.2 5.7,-1.3c1.4,-1.4 1.9,-3.4 1.4,-5.3l9.1,9.1c0.6,0.6 0.6,1.5 0,2.1c-0.6,0.6 -1.5,0.6 -2.1,0l-5,-5l-1.4,1.4l5,5c1.4,1.4 3.6,1.4 4.9,0c1.4,-1.4 1.4,-3.6 0,-4.9z" />

    <!-- The screwdriver, crossing it the other way: blade low left, handle
