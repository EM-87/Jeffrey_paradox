<!-- A spanner and a screwdriver, crossed.

     Crossed is how a workshop draws it, and the first two attempts at it
     came out as a lump with a diagonal in it: two solid shapes laid over
     one another have nothing between them, and a vector drawable cannot
     punch one shape out of another. The third attempt gave up and stood
     them side by side, which was legible and was not the picture.

     The trick is that neither tool has to be cut out — the spanner is
     simply drawn in two pieces, with a channel of background where the
     screwdriver goes past. Nothing overlaps, so nothing has to be
     resolved, and the eye reads the gap as the handle lying on top, which
     is what it would be reading in a shaded drawing anyway.

     It sits opposite the gear because the two are the same kind of thing —
     a way out of the clock — and a lone button in a corner with nothing
     across from it reads as a mistake. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- The spanner, running from the top-left corner to the bottom-right.
         Drawn upright and turned, because an open jaw is a fiddly path and
         a fiddly path written on the diagonal is a fiddly path nobody can
         read afterwards. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-45">

        <!-- The upper jaw: two prongs and the slot between them, which is
             the one feature that says spanner rather than hammer. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M8.9,6.4 L8.9,2.6 Q8.9,1.3 10.2,1.3 L10.45,1.3 L10.45,3.6 Q10.45,4.5 11.35,4.5 L12.65,4.5 Q13.55,4.5 13.55,3.6 L13.55,1.3 L13.8,1.3 Q15.1,1.3 15.1,2.6 L15.1,6.4 Z" />

        <!-- The shaft, in two pieces. The space between them is where the
             screwdriver's handle passes, and it is the whole reason this
             reads as two tools instead of one blot. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M10.7,5.8 L13.3,5.8 L13.3,8.8 L10.7,8.8 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M10.7,15.2 L13.3,15.2 L13.3,18.2 L10.7,18.2 Z" />

        <!-- The lower jaw, the same the other way up. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M8.9,17.6 L8.9,21.4 Q8.9,22.7 10.2,22.7 L10.45,22.7 L10.45,20.4 Q10.45,19.5 11.35,19.5 L12.65,19.5 Q13.55,19.5 13.55,20.4 L13.55,22.7 L13.8,22.7 Q15.1,22.7 15.1,21.4 L15.1,17.6 Z" />

    </group>

    <!-- The screwdriver, the other diagonal, lying on top. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">

        <!-- A blade wider than the shaft and flat across the end: the
             other one-feature-that-names-it. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M10.7,1.4 L13.3,1.4 L13.3,4.6 L10.7,4.6 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11.25,4.4 L12.75,4.4 L12.75,10.4 L11.25,10.4 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M10.2,10.2 L13.8,10.2 L13.8,11.9 L10.2,11.9 Z" />

        <!-- The handle: the fattest thing in the icon, and the thing the
             gap in the spanner is cut to fit. -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M9.7,11.7 L14.3,11.7 L14.3,20.0 Q14.3,21.8 12.0,21.8 Q9.7,21.8 9.7,20.0 Z" />

    </group>

</vector>
