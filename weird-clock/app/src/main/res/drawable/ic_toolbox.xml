<!-- A toolbox: a case with a handle, a lid and a catch.

     It was a spanner and a screwdriver crossed, which is the mark every
     workshop uses and which does not survive being drawn at twenty-four
     density-independent pixels: two long thin shapes laid over one another
     in the same solid colour have no gap left between them, so what
     arrived on the glass was a blot with a diagonal in it.

     A toolbox has one outline and three parts that do not touch, so the
     eye gets the shape before it gets any detail — which is the whole
     requirement for something a thumb finds at arm's length. It still
     means the same thing: the button that puts the hands back is the one
     you open when something has come apart.

     It sits opposite the gear because the two are the same kind of thing —
     a way out of the clock — and a lone button in a corner with nothing
     across from it reads as a mistake. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- The handle: a strap over the top, drawn as a line rather than a
         shape so it stays a handle at this size instead of closing up into
         a lump. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8.6,8 L8.6,6.6 A2,2 0 0 1 10.6,4.6 L13.4,4.6 A2,2 0 0 1 15.4,6.6 L15.4,8"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />

    <!-- The lid. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3.7,8.6 L20.3,8.6 A1.4,1.4 0 0 1 21.7,10 L21.7,11.9 L2.3,11.9 L2.3,10 A1.4,1.4 0 0 1 3.7,8.6 Z" />

    <!-- The box under it, with a clear line of daylight between the two so
         the lid reads as a lid. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.3,13.1 L21.7,13.1 L21.7,18.6 A1.4,1.4 0 0 1 20.3,20 L3.7,20 A1.4,1.4 0 0 1 2.3,18.6 Z" />

    <!-- And the catch that holds them shut, which is the one piece of
         detail small enough to survive. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.8,11 L13.2,11 L13.2,15.2 L10.8,15.2 Z" />

</vector>
