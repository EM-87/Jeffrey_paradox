        android:pathData="M18.3,2.1l-7.4,7.4l1.4,1.4l0.7,-0.7l1.4,1.4l-7.8,7.8c-0.6,0.6 -0.6,1.5 0,2.1c0.6,0.6 1.5,0.6 2.1,0l7.8,-7.8l1.4,1.4l0.7,-0.7l1.4,1.4l2.1,-2.1z" />

