<?xml version="1.0" encoding="utf-8"?>
<!--
    Options: the things somebody actually comes here to change.

    Sorted by what they are about rather than by how clever they are, and
    kept short by one rule above all: a switch lives here and everything
    that refines it lives on the advanced page. Whether the bells ring is a
    question you answer once and might change any evening; which quarters
    they mark and what they sound like are questions you answer once and
    never revisit, and they were making this page twice as long as the
    decisions it actually holds.

    The two deeper screens both hang off this one rather than off each
    other, so getting from the far end of the settings back to the clock is
    one press of Back and not three.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The first question, above every category, because it decides what
         the categories are about. A person who finds a dial hard work sets
         this to digits once and never opens the settings again. -->
    <ListPreference
        android:defaultValue="analog"
        android:entries="@array/face_entries"
        android:entryValues="@array/face_values"
        android:key="pref_face"
        android:summary="@string/pref_face_summary"
        android:title="@string/pref_face_title" />

    <!-- Keyed so the heading can be renamed with the face: a screenful of
         digits has no dial, and a category called Dial over three rows
         that still apply to it is the app failing to notice what it is. -->
    <PreferenceCategory
        android:key="cat_dial"
        android:title="@string/category_dial">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_night_dim"
            android:summary="@string/pref_night_dim_summary"
            android:title="@string/pref_night_dim_title" />

        <ListPreference
            android:defaultValue="midnight"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="pref_theme"
            android:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_show_date"
            android:summary="@string/pref_show_date_summary"
            android:title="@string/pref_show_date_title" />

        <!-- The day of the week, which is the one thing about today a
             number cannot tell you. Only on the face made of digits: the
             dial's date is a caption under the hands and has no room. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_weather"
            android:summary="@string/pref_weather_summary"
            android:title="@string/pref_weather_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_show_weekday"
            android:summary="@string/pref_show_weekday_summary"
            android:title="@string/pref_show_weekday_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_alarms">

        <!-- A flag on the face saying one is armed. Not "when is my
             alarm", which is what the list is for: "did I set one". -->
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_next_alarm"
            android:summary="@string/pref_next_alarm_summary"
            android:title="@string/pref_next_alarm_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bells"
            android:summary="@string/pref_bells_summary"
            android:title="@string/pref_bells_title" />

        <!-- Whether the dial carries any alarm marks at all. What colour
             they are is a decision, and decisions live on the advanced
             page. -->
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_alarm_markers"
            android:summary="@string/pref_alarm_markers_summary"
            android:title="@string/pref_alarm_markers_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_calendar">

        <Preference
            android:key="pref_birthday"
            android:summary="@string/pref_birthday_summary"
            android:title="@string/pref_birthday_title" />

        <Preference
            android:key="pref_cycle"
            android:summary="@string/cycle_summary"
            android:title="@string/cycle_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_general">

        <!-- One switch for the whole sky. It used to be three, nested:
             the moon complication, then the solar system behind it, then
             the comets on that — which is the order they were built in and
             not the order anybody thinks about them. Nobody wants "a moon
             glyph"; they want the planets, and the glyph is the door. So
             the door is the switch, and what is behind it is furniture on
             the advanced page. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_orrery"
            android:summary="@string/orrery_summary"
            android:title="@string/orrery_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_world_clock"
            android:summary="@string/pref_world_clock_summary"
            android:title="@string/pref_world_clock_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_world_seconds"
            android:summary="@string/pref_world_seconds_summary"
            android:title="@string/pref_world_seconds_title" />

        <Preference
            android:key="pref_world_cities"
            android:title="@string/pref_world_cities_title" />

    </PreferenceCategory>

    <!-- No title on purpose: it is a rule across the page, not a heading.
         The two doors below were being read as two more General options,
         which is what a list with no break in it does to whatever sits at
         the bottom of it. -->
    <PreferenceCategory />

    <!-- Both deeper screens hang off this one. They used to be a ladder —
         options, then advanced, then too advanced — so coming back to the
         clock from the far end meant pressing Back three times to see what
         you had just changed. -->
    <Preference
        android:key="pref_advanced"
        android:summary="@string/pref_advanced_summary"
        android:title="@string/pref_advanced_title" />

    <Preference
        android:key="pref_very_advanced"
        android:summary="@string/pref_very_advanced_summary"
        android:title="@string/pref_very_advanced_title" />

    <Preference
        android:key="pref_version"
        android:title="@string/pref_version_title" />

</PreferenceScreen>
