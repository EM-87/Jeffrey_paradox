<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/category_dial">

        <ListPreference
            android:key="pref_theme"
            android:title="@string/pref_theme_title"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:defaultValue="midnight"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_24h_dial"
            android:title="@string/pref_24h_title"
            android:summary="@string/pref_24h_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="pref_numerals"
            android:title="@string/pref_numerals_title"
            android:entries="@array/numeral_entries"
            android:entryValues="@array/numeral_values"
            android:defaultValue="arabic"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_mirror"
            android:title="@string/pref_mirror_title"
            android:summary="@string/pref_mirror_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_show_date"
            android:title="@string/pref_show_date_title"
            android:summary="@string/pref_show_date_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="pref_date_format"
            android:title="@string/pref_date_format_title"
            android:entries="@array/date_format_entries"
            android:entryValues="@array/date_format_values"
            android:defaultValue="number"
            android:dependency="pref_show_date"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_hands">

        <SwitchPreferenceCompat
            android:key="pref_second_hand"
            android:title="@string/pref_second_hand_title"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_smooth_seconds"
            android:title="@string/pref_smooth_title"
            android:summary="@string/pref_smooth_summary"
            android:dependency="pref_second_hand"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_decimal_hand"
            android:title="@string/pref_decimal_title"
            android:summary="@string/pref_decimal_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_touch">

        <SwitchPreferenceCompat
            android:key="pref_touch_hands"
            android:title="@string/pref_touch_hands_title"
            android:summary="@string/pref_touch_hands_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_pinch_zoom"
            android:title="@string/pref_pinch_zoom_title"
            android:summary="@string/pref_pinch_zoom_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_sounds">

        <SwitchPreferenceCompat
            android:key="pref_bells"
            android:title="@string/pref_bells_title"
            android:summary="@string/pref_bells_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="pref_bell_style"
            android:title="@string/pref_bell_style_title"
            android:entries="@array/bell_style_entries"
            android:entryValues="@array/bell_style_values"
            android:defaultValue="count"
            android:dependency="pref_bells"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_half_hour"
            android:title="@string/pref_half_hour_title"
            android:summary="@string/pref_half_hour_summary"
            android:dependency="pref_bells"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_ticking"
            android:title="@string/pref_ticking_title"
            android:summary="@string/pref_ticking_summary"
            android:defaultValue="false" />

        <Preference
            android:key="pref_test_bells"
            android:title="@string/pref_test_bells_title"
            android:summary="@string/pref_test_bells_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_alarms">

        <Preference
            android:key="pref_set_alarm"
            android:title="@string/pref_set_alarm_title"
            android:summary="@string/pref_set_alarm_summary" />

    </PreferenceCategory>

</PreferenceScreen>
