<?xml version="1.0" encoding="utf-8"?>
<!--
    Options: the things somebody actually comes here to change.

    Sorted by what they are about rather than by how clever they are, and
    kept short by two rules. A row whose answer only matters once another
    row is switched on does not appear until it is — the app's hours are no
    question at all while the night mode is off — so the list you scroll is
    only the list you are using. And the two deeper screens both hang off
    this one rather than off each other, so getting from the far end of the
    settings back to the clock is one press of Back and not three.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/category_dial">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_night_dim"
            android:summary="@string/pref_night_dim_summary"
            android:title="@string/pref_night_dim_title" />

        <com.em87.weirdclock.NightWindowPreference
            android:key="pref_night_window"
            app:iconSpaceReserved="true"
            android:title="@string/pref_night_window_title" />

        <ListPreference
            android:defaultValue="midnight"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="pref_theme"
            android:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_show_date"
            android:summary="@string/pref_show_date_summary"
            android:title="@string/pref_show_date_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_alarms">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bells"
            android:summary="@string/pref_bells_summary"
            android:title="@string/pref_bells_title" />

        <ListPreference
            android:defaultValue="hour"
            android:entries="@array/bell_marks_entries"
            android:entryValues="@array/bell_marks_values"
            android:key="pref_bell_marks"
            app:iconSpaceReserved="true"
            android:title="@string/pref_bell_marks_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="count"
            android:entries="@array/bell_style_entries"
            android:entryValues="@array/bell_style_values"
            android:key="pref_bell_style"
            app:iconSpaceReserved="true"
            android:title="@string/pref_bell_style_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bells_background"
            app:iconSpaceReserved="true"
            android:summary="@string/pref_bells_background_summary"
            android:title="@string/pref_bells_background_title" />

        <ListPreference
            android:defaultValue="alarm"
            android:entries="@array/bell_priority_entries"
            android:entryValues="@array/bell_priority_values"
            android:key="pref_bell_priority"
            app:iconSpaceReserved="true"
            android:summary="@string/pref_bell_priority_summary"
            android:title="@string/pref_bell_priority_title" />

        <!-- Up from the advanced screen. It answers "what is my next alarm"
             at a glance, which is the most ordinary question anybody asks
             this app, and it was two screens down. -->
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_alarm_markers"
            android:summary="@string/pref_alarm_markers_summary"
            android:title="@string/pref_alarm_markers_title" />

        <Preference
            android:key="pref_test_bells"
            app:iconSpaceReserved="true"
            android:summary="@string/pref_test_bells_summary"
            android:title="@string/pref_test_bells_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_calendar">

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/past_days_entries"
            android:entryValues="@array/past_days_values"
            android:key="pref_past_days"
            android:summary="@string/pref_past_days_summary"
            android:title="@string/pref_past_days_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="pref_birthday"
            android:summary="@string/pref_birthday_summary"
            android:title="@string/pref_birthday_title" />

        <Preference
            android:key="pref_cycle"
            android:summary="@string/cycle_summary"
            android:title="@string/cycle_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_general">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_moon_phase"
            android:summary="@string/pref_moon_phase_summary"
            android:title="@string/pref_moon_phase_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_orrery"
            app:iconSpaceReserved="true"
            android:summary="@string/orrery_summary"
            android:title="@string/orrery_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_world_clock"
            android:summary="@string/pref_world_clock_summary"
            android:title="@string/pref_world_clock_title" />

        <Preference
            android:key="pref_world_cities"
            app:iconSpaceReserved="true"
            android:title="@string/pref_world_cities_title" />

    </PreferenceCategory>

    <!-- No title on purpose: it is a rule across the page, not a heading.
         The two doors below were being read as two more General options,
         which is what a list with no break in it does to whatever sits at
         the bottom of it. -->
    <PreferenceCategory />

    <!-- Both deeper screens hang off this one. They used to be a ladder —
         options, then advanced, then too advanced — so coming back to the
         clock from the far end meant pressing Back three times to see what
         you had just changed. -->
    <Preference
        android:key="pref_advanced"
        android:summary="@string/pref_advanced_summary"
        android:title="@string/pref_advanced_title" />

    <Preference
        android:key="pref_very_advanced"
        android:summary="@string/pref_very_advanced_summary"
        android:title="@string/pref_very_advanced_title" />

    <Preference
        android:key="pref_armed"
        android:selectable="false"
        android:title="@string/pref_armed_title" />

    <Preference
        android:key="pref_tick_precision"
        android:selectable="false"
        android:title="@string/pref_tick_precision_title" />

    <Preference
        android:key="pref_version"
        android:title="@string/pref_version_title" />

</PreferenceScreen>
