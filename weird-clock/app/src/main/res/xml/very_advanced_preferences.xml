<?xml version="1.0" encoding="utf-8"?>
<!--
    Too-advanced options: the machinery, and the two ways out.

    What separates this screen from the one before it is not difficulty but
    consequence. Everything here either changes how the clock answers to a
    finger, or lets it lie about the time, or moves your data — and the
    last two are things you should have to go looking for.

    It hangs off the first screen rather than off the second, so Back from
    here lands on the options and the next Back on the clock, which is
    where you go to see what you have just done.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Keyed so the heading can be renamed with the face, like the one
         on the other two screens: what is left under it on a clock with
         no dial is still about the clock, but not about a dial. -->
    <PreferenceCategory
        android:key="cat_dial_deep"
        android:title="@string/category_dial">

        <!-- The hands, from the slowest one anybody would think of turning
             off downwards. A clock with no minute hand is a clock you read
             to the nearest hour, which is how a great many of them were
             read for a great many centuries. -->
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_minute_hand"
            android:summary="@string/pref_minute_hand_summary"
            android:title="@string/pref_minute_hand_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_second_hand"
            android:title="@string/pref_second_hand_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_smooth_seconds"
            android:summary="@string/pref_smooth_summary"
            android:title="@string/pref_smooth_title" />

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/fast_hand_entries"
            android:entryValues="@array/fast_hand_values"
            android:key="pref_fast_hand"
            android:title="@string/pref_fast_hand_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Down from the advanced screen, and under the second hand where
             it belongs: the tick is the sound of that hand moving, and
             offering it on a dial with no second hand on it is offering the
             sound of something that is not there. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_ticking"
            android:summary="@string/pref_ticking_summary"
            android:title="@string/pref_ticking_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_touch_hands"
            android:summary="@string/pref_touch_hands_summary"
            android:title="@string/pref_touch_hands_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_pinch_zoom"
            android:summary="@string/pref_pinch_zoom_summary"
            android:title="@string/pref_pinch_zoom_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_shake_drop"
            android:summary="@string/pref_shake_drop_summary"
            android:title="@string/pref_shake_drop_title" />

        <!-- The same joke on the other face: a dial you can knock the
             hands off, a display you can put a dead segment in. Off,
             because somebody who chose digits chose them for clarity. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_poke_segments"
            android:summary="@string/pref_poke_segments_summary"
            android:title="@string/pref_poke_segments_title" />

    </PreferenceCategory>

    <!-- Named for what it holds rather than for what is left over.
         "General" is the heading a screen gives a row when nobody has
         decided where it goes, and this row has a subject: it is the one
         place the app asks for a permission from Android. -->
    <PreferenceCategory android:title="@string/category_widgets">

        <ListPreference
            android:defaultValue="overlay"
            android:entries="@array/countdown_float_entries"
            android:entryValues="@array/countdown_float_values"
            android:key="pref_countdown_float"
            android:summary="@string/pref_countdown_float_summary"
            android:title="@string/pref_countdown_float_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_time">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_solar_time"
            android:summary="@string/pref_solar_time_summary"
            android:title="@string/pref_solar_time_title" />

        <Preference
            android:key="pref_system_time"
            android:summary="@string/pref_system_time_summary"
            android:title="@string/pref_system_time_title" />

        <SeekBarPreference
            android:defaultValue="100"
            android:key="pref_time_speed"
            android:max="400"
            android:summary="@string/pref_time_speed_summary"
            android:title="@string/pref_time_speed_title"
            app:min="25"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_backup">

        <!-- The automatic half, first, because it is the one that saves
             somebody who never thinks about backups — which is everybody,
             until the morning they need one. -->
        <Preference
            android:key="pref_backup_folder"
            android:summary="@string/pref_backup_folder_summary"
            android:title="@string/pref_backup_folder_title" />

        <Preference
            android:key="pref_backup_export"
            android:summary="@string/pref_backup_export_summary"
            android:title="@string/pref_backup_export_title" />

        <Preference
            android:key="pref_backup_import"
            android:summary="@string/pref_backup_import_summary"
            android:title="@string/pref_backup_import_title" />

    </PreferenceCategory>

    <!-- What the app can see of itself, below a rule of its own. Neither
         is a setting: one says whether the system has an alarm of ours
         registered, the other what the tick has actually been doing. They
         answer questions nobody can answer from anywhere else, and they
         answer them by being read rather than pressed — so they belong at
         the end, apart from the things that change something. -->
    <PreferenceCategory />

    <Preference
        android:key="pref_armed"
        android:selectable="false"
        android:title="@string/pref_armed_title" />

    <Preference
        android:key="pref_tick_precision"
        android:selectable="false"
        android:title="@string/pref_tick_precision_title" />

</PreferenceScreen>
