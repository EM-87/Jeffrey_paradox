<?xml version="1.0" encoding="utf-8"?>
<!--
    Advanced options: the things you set once and then live with.

    Nothing here is dangerous — the clock still tells the time whatever you
    do on this screen. It is the second screen rather than the first only
    because these are decisions, not adjustments: you pick your numerals
    once and never think about them again.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The digits' own settings. They are only on the page at all when
         the face is digital — see [FaceOptions] — so they need no switch
         of their own to hide behind. -->
    <PreferenceCategory android:title="@string/category_digits">

        <ListPreference
            android:defaultValue="segment"
            android:entries="@array/digit_style_entries"
            android:entryValues="@array/digit_style_values"
            android:key="pref_digit_style"
            android:title="@string/pref_digit_style_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="arabic"
            android:entries="@array/digit_script_entries"
            android:entryValues="@array/digit_script_values"
            android:key="pref_digit_script"
            android:title="@string/pref_digit_script_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_hour_24"
            android:summary="@string/pref_hour_24_summary"
            android:title="@string/pref_hour_24_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_leading_zero"
            android:summary="@string/pref_leading_zero_summary"
            android:title="@string/pref_leading_zero_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_blink_colon"
            android:summary="@string/pref_blink_colon_summary"
            android:title="@string/pref_blink_colon_title" />

        <!-- The pen the display is stamped with, and whether the bars it
             is not using are drawn. Both are about the instrument rather
             than about the time, which is why they are here and not on the
             first screen. -->
        <ListPreference
            android:defaultValue="normal"
            android:entries="@array/segment_weight_entries"
            android:entryValues="@array/segment_weight_values"
            android:key="pref_segment_weight"
            android:title="@string/pref_segment_weight_title"
            app:useSimpleSummaryProvider="true" />

        <!-- The turning world's own rows. Everything here is about how
             the planet is being looked at, which is the only decision
             this face offers: what it says is not a preference, it is
             where the sun is. -->
        <ListPreference
            android:defaultValue="north"
            android:entries="@array/hemisphere_view_entries"
            android:entryValues="@array/hemisphere_view_values"
            android:key="pref_hemisphere_view"
            android:title="@string/pref_hemisphere_view_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:defaultValue="0"
            android:key="pref_hemisphere_sun_at"
            android:max="330"
            android:title="@string/pref_hemisphere_sun_at_title"
            android:summary="@string/pref_hemisphere_sun_at_summary"
            app:min="0"
            app:seekBarIncrement="30"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_hemisphere_ring"
            android:summary="@string/pref_hemisphere_ring_summary"
            android:title="@string/pref_hemisphere_ring_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_hemisphere_numbers"
            android:summary="@string/pref_hemisphere_numbers_summary"
            android:title="@string/pref_hemisphere_numbers_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_hemisphere_meridians"
            android:summary="@string/pref_hemisphere_meridians_summary"
            android:title="@string/pref_hemisphere_meridians_title" />

        <!-- The sundial's own rows. Every one of them is about the
             instrument rather than about the time, which is why they are
             here and not on the first screen — except the latitude,
             which is the one number the thing cannot work without and is
             here because that is where its neighbours are. -->
        <ListPreference
            android:defaultValue="floor"
            android:entries="@array/sundial_kind_entries"
            android:entryValues="@array/sundial_kind_values"
            android:key="pref_sundial_kind"
            android:title="@string/pref_sundial_kind_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="round"
            android:entries="@array/sundial_plate_entries"
            android:entryValues="@array/sundial_plate_values"
            android:key="pref_sundial_plate"
            android:title="@string/pref_sundial_plate_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_sundial_latitude_fixed"
            android:summary="@string/pref_sundial_latitude_fixed_summary"
            android:title="@string/pref_sundial_latitude_fixed_title" />

        <SeekBarPreference
            android:defaultValue="40"
            android:key="pref_sundial_latitude"
            android:max="89"
            android:title="@string/pref_sundial_latitude_title"
            app:min="-89"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_sundial_compass"
            android:summary="@string/pref_sundial_compass_summary"
            android:title="@string/pref_sundial_compass_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_sundial_roman"
            android:summary="@string/pref_sundial_roman_summary"
            android:title="@string/pref_sundial_roman_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_sundial_halves"
            android:summary="@string/pref_sundial_halves_summary"
            android:title="@string/pref_sundial_halves_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_sundial_julian"
            android:summary="@string/pref_sundial_julian_summary"
            android:title="@string/pref_sundial_julian_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_sundial_motto"
            android:summary="@string/pref_sundial_motto_summary"
            android:title="@string/pref_sundial_motto_title" />

        <!-- What survives when the phone goes on its side and the clock
             takes the screen. Off by default: full screen was asked for
             as a way of getting rid of things, and a bedside clock with
             the seconds running and a date under them is the card again,
             only bigger. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bedside_seconds"
            android:summary="@string/pref_bedside_seconds_summary"
            android:title="@string/pref_bedside_seconds_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bedside_date"
            android:summary="@string/pref_bedside_date_summary"
            android:title="@string/pref_bedside_date_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_segment_ghosts"
            android:summary="@string/pref_segment_ghosts_summary"
            android:title="@string/pref_segment_ghosts_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_dial"
        android:title="@string/category_dial">

        <ListPreference
            android:defaultValue="arabic"
            android:entries="@array/numeral_entries"
            android:entryValues="@array/numeral_values"
            android:key="pref_numerals"
            android:title="@string/pref_numerals_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="circle"
            android:entries="@array/dial_shape_entries"
            android:entryValues="@array/dial_shape_values"
            android:key="pref_dial_shape"
            android:title="@string/pref_dial_shape_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="12"
            android:entries="@array/hours_preset_entries"
            android:entryValues="@array/hours_preset_values"
            android:key="pref_hours_preset"
            android:title="@string/pref_hours_preset_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:defaultValue="12"
            android:key="pref_hours_custom"
            android:max="24"
            android:title="@string/pref_hours_custom_title"
            app:min="2"
            app:showSeekBarValue="true" />

        <ListPreference
            android:defaultValue="number"
            android:entries="@array/date_format_entries"
            android:entryValues="@array/date_format_values"
            android:key="pref_date_format"
            android:title="@string/pref_date_format_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Which of the two numbers is the day. Nothing to do with the row
             above, which is how the date is spelled: 03/04 is the third of
             April or the fourth of March, and there is nothing in it to say
             which. -->
        <ListPreference
            android:defaultValue="auto"
            android:entries="@array/date_order_entries"
            android:entryValues="@array/date_order_values"
            android:key="pref_date_order"
            android:title="@string/pref_date_order_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_mirror"
            android:summary="@string/pref_mirror_summary"
            android:title="@string/pref_mirror_title" />

        <!-- How many hours are marked, and whether the sixty minute ticks
             are there at all. A dial with four marks on it is a perfectly
             ordinary way to make a clock, and the numerals follow: asking
             for four marks and getting twelve numerals is a dial that has
             half heard you. -->
        <ListPreference
            android:defaultValue="12"
            android:entries="@array/dial_marks_entries"
            android:entryValues="@array/dial_marks_values"
            android:key="pref_dial_marks"
            android:title="@string/pref_dial_marks_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_minute_marks"
            android:summary="@string/pref_minute_marks_summary"
            android:title="@string/pref_minute_marks_title" />

        <!-- Up from the too-advanced screen, where nobody found it, and
             with the question it raises underneath: a shadow has to fall
             on something, and where the clock is standing decides what
             the sun does to it. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_hand_shadows"
            android:summary="@string/pref_hand_shadows_summary"
            android:title="@string/pref_hand_shadows_title" />

        <ListPreference
            android:defaultValue="ground"
            android:entries="@array/shadow_surface_entries"
            android:entryValues="@array/shadow_surface_values"
            android:key="pref_shadow_surface"
            android:title="@string/pref_shadow_surface_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Which hours count as night. Down from the first screen, where
             the switch stays: whether the dial dims at night is something
             you might change any evening, and which hours those are is a
             fact about your household you set once. -->
        <com.em87.weirdclock.NightWindowPreference
            android:key="pref_night_window"
            android:title="@string/pref_night_window_title" />

    </PreferenceCategory>

    <!--
        The bells' own settings, down from the first screen.

        They are faded rather than hidden while the bells are switched off,
        and they still work. Hiding them would have been the usual rule
        here, and it is the wrong one across a screen boundary: somebody
        who comes to this page looking for the bell style and finds nothing
        concludes the app has lost it, not that a switch two screens back
        is off. Faded says the same thing and answers the question.
    -->
    <PreferenceCategory android:title="@string/category_bells">

        <ListPreference
            android:defaultValue="hour"
            android:entries="@array/bell_marks_entries"
            android:entryValues="@array/bell_marks_values"
            android:key="pref_bell_marks"
            android:title="@string/pref_bell_marks_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="count"
            android:entries="@array/bell_style_entries"
            android:entryValues="@array/bell_style_values"
            android:key="pref_bell_style"
            android:title="@string/pref_bell_style_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_bells_background"
            android:summary="@string/pref_bells_background_summary"
            android:title="@string/pref_bells_background_title" />

        <ListPreference
            android:defaultValue="alarm"
            android:entries="@array/bell_priority_entries"
            android:entryValues="@array/bell_priority_values"
            android:key="pref_bell_priority"
            android:summary="@string/pref_bell_priority_summary"
            android:title="@string/pref_bell_priority_title" />

        <Preference
            android:key="pref_test_bells"
            android:summary="@string/pref_test_bells_summary"
            android:title="@string/pref_test_bells_title" />

    </PreferenceCategory>

    <!--
        The sky's furniture, behind the one switch that opens it.

        The moon complication is here rather than on the first screen
        because it is not what anybody turns the sky on for: the glyph is
        the door, and the door is the switch upstairs. What is left down
        here are the three questions about what is drawn once you are
        through it.
    -->
    <PreferenceCategory android:title="@string/category_orrery">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_moon_phase"
            android:summary="@string/pref_moon_phase_summary"
            android:title="@string/pref_moon_phase_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_comets"
            android:summary="@string/comets_summary"
            android:title="@string/comets_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_zodiac"
            android:summary="@string/pref_zodiac_summary"
            android:title="@string/pref_zodiac_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_calendar">

        <!-- The month page writes its days in its own numerals. It used to
             borrow the dial's, which is a different question with a
             different answer: Roman numerals are a fine thing to have on a
             clock face and a grid of thirty-one of them is a puzzle. -->
        <ListPreference
            android:defaultValue="arabic"
            android:entries="@array/numeral_entries"
            android:entryValues="@array/numeral_values"
            android:key="pref_calendar_numerals"
            android:summary="@string/pref_calendar_numerals_summary"
            android:title="@string/pref_calendar_numerals_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/past_days_entries"
            android:entryValues="@array/past_days_values"
            android:key="pref_past_days"
            android:summary="@string/pref_past_days_summary"
            android:title="@string/pref_past_days_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_alarms">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_alarm_ramp"
            android:summary="@string/pref_alarm_ramp_summary"
            android:title="@string/pref_alarm_ramp_title" />

        <ListPreference
            android:defaultValue="3"
            android:entries="@array/ring_timeout_entries"
            android:entryValues="@array/ring_timeout_values"
            android:key="pref_ring_timeout"
            android:summary="@string/pref_ring_timeout_summary"
            android:title="@string/pref_ring_timeout_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_countdown_persistent"
            android:summary="@string/pref_countdown_persistent_summary"
            android:title="@string/pref_countdown_persistent_title" />

        <ListPreference
            android:defaultValue="analog"
            android:entries="@array/alarm_style_entries"
            android:entryValues="@array/alarm_style_values"
            android:key="pref_alarm_style"
            android:summary="@string/pref_alarm_style_summary"
            android:title="@string/pref_alarm_style_title"
            app:useSimpleSummaryProvider="true" />

        <!-- The torch that takes over when a gradual sunrise has had its go
             and failed. It belongs here rather than on each alarm because
             it is an answer about you and not about one morning: whether a
             sleeper the light does not reach wants the light turned up. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_gentle_flash"
            android:summary="@string/pref_gentle_flash_summary"
            android:title="@string/pref_gentle_flash_title" />

        <!-- What the alarm marks on the dial are coloured by. Back here,
             where it started: it is a decision about how the dial is drawn,
             and the switch that says whether there are any marks at all is
             the one that belongs on the first screen. -->
        <ListPreference
            android:defaultValue="clock"
            android:entries="@array/mark_colors_entries"
            android:entryValues="@array/mark_colors_values"
            android:key="pref_mark_colors"
            android:title="@string/pref_mark_colors_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
