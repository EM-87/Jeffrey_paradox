<?xml version="1.0" encoding="utf-8"?>
<!--
    Advanced options: the things you set once and then live with.

    Nothing here is dangerous — the clock still tells the time whatever you
    do on this screen. It is the second screen rather than the first only
    because these are decisions, not adjustments: you pick your numerals
    once and never think about them again.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/category_dial">

        <ListPreference
            android:defaultValue="arabic"
            android:entries="@array/numeral_entries"
            android:entryValues="@array/numeral_values"
            android:key="pref_numerals"
            android:title="@string/pref_numerals_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="circle"
            android:entries="@array/dial_shape_entries"
            android:entryValues="@array/dial_shape_values"
            android:key="pref_dial_shape"
            android:title="@string/pref_dial_shape_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="12"
            android:entries="@array/hours_preset_entries"
            android:entryValues="@array/hours_preset_values"
            android:key="pref_hours_preset"
            android:title="@string/pref_hours_preset_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:defaultValue="12"
            android:key="pref_hours_custom"
            android:max="24"
            android:title="@string/pref_hours_custom_title"
            app:min="2"
            app:showSeekBarValue="true" />

        <ListPreference
            android:defaultValue="number"
            android:entries="@array/date_format_entries"
            android:entryValues="@array/date_format_values"
            android:key="pref_date_format"
            android:title="@string/pref_date_format_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Which of the two numbers is the day. Nothing to do with the row
             above, which is how the date is spelled: 03/04 is the third of
             April or the fourth of March, and there is nothing in it to say
             which. -->
        <ListPreference
            android:defaultValue="auto"
            android:entries="@array/date_order_entries"
            android:entryValues="@array/date_order_values"
            android:key="pref_date_order"
            android:title="@string/pref_date_order_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_mirror"
            android:summary="@string/pref_mirror_summary"
            android:title="@string/pref_mirror_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_alarms">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_alarm_ramp"
            android:summary="@string/pref_alarm_ramp_summary"
            android:title="@string/pref_alarm_ramp_title" />

        <ListPreference
            android:defaultValue="3"
            android:entries="@array/ring_timeout_entries"
            android:entryValues="@array/ring_timeout_values"
            android:key="pref_ring_timeout"
            android:summary="@string/pref_ring_timeout_summary"
            android:title="@string/pref_ring_timeout_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_countdown_persistent"
            android:summary="@string/pref_countdown_persistent_summary"
            android:title="@string/pref_countdown_persistent_title" />

        <ListPreference
            android:defaultValue="analog"
            android:entries="@array/alarm_style_entries"
            android:entryValues="@array/alarm_style_values"
            android:key="pref_alarm_style"
            android:summary="@string/pref_alarm_style_summary"
            android:title="@string/pref_alarm_style_title"
            app:useSimpleSummaryProvider="true" />

        <!-- The torch that takes over when a gradual sunrise has had its go
             and failed. It belongs here rather than on each alarm because
             it is an answer about you and not about one morning: whether a
             sleeper the light does not reach wants the light turned up. -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_gentle_flash"
            android:summary="@string/pref_gentle_flash_summary"
            android:title="@string/pref_gentle_flash_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_alarm_markers"
            android:summary="@string/pref_alarm_markers_summary"
            android:title="@string/pref_alarm_markers_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_general">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_ticking"
            android:summary="@string/pref_ticking_summary"
            android:title="@string/pref_ticking_title" />

    </PreferenceCategory>

</PreferenceScreen>
