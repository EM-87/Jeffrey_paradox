    <string name="pref_hand_shadows_title">Hand shadows</string>
    <string name="pref_hand_shadows_summary">The clock lies flat with 12 pointing north and the real sun crosses over it. The three hands sit at three heights, so they throw three shadows — none at all when the sun is overhead, long and slanted near the poles.</string>
