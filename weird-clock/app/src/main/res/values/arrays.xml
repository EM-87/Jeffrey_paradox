    <!-- Which calendar the sundial's date is read in. None of the three is
         offered as better than ours: the Julian is the one the stone would
         have been cut under, and the Egyptian is the one Ptolemy and
         Copernicus both did their arithmetic in. -->
    <string-array name="sundial_calendar_entries">
