<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The first network this clock has ever wanted, and it is off until
      somebody switches it on: Android grants the internet at install with
      no prompt, so the asking has to be a switch inside the app that says
      what it is going to do. See WeatherStore.
    -->
    <!-- Read only, and there is no write anywhere in this app. A clock
         that can see the diary is not a diary. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeirdClock">

        <!-- configChanges keeps the activity alive on rotation, so fallen
             pieces, winding and chrono state survive orientation changes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: straight to the card you wanted. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The standard clock intents. Answering these is what lets the
             assistant, the launcher and other apps hand this app work:
             "set an alarm for seven", "set a timer for ten minutes", "show
             my alarms". No window of its own — it acts and steps aside. -->
        <activity
            android:name=".ClockIntentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <action android:name="com.em87.weirdclock.action.SHOW_STOPWATCH" />
                <action android:name="com.em87.weirdclock.action.SHOW_CALENDAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- The widget's configuration screen, opened by the launcher from
             the gear in the long-press popup.

             Its own task affinity, and nothing else in it: on the app's
             task, closing this landed on whatever the app had open — so
             somebody who was on the home screen a second ago found
             themselves inside the clock. Empty affinity keeps it out of
             the app's back stack entirely, and Back goes where it came
             from. -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:exported="true"
            android:label="@string/widget_settings_title"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WeirdClock.WidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BpmActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".AlarmRingActivity"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Quick Settings tiles: the shade is where a clock app has to be
             present, and a tile reports state rather than just launching. -->
        <service
            android:name=".TimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_timer"
            android:label="@string/tile_timer_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_alarm_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".CountdownService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".BellService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BellReceiver"
            android:exported="false" />

        <!-- The alarm before the alarm: one webhook and nothing else. -->
        <receiver
            android:name=".HouseReceiver"
            android:exported="false" />

        <receiver
            android:name=".RearmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Every build handed to this phone cancels its alarms. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- And an armed alarm is an instant, not a time of day. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The dial bitmap carries the date, so it needs redrawing
                     when the date itself moves. -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- And its own wake-up for sunrise and sunset, which the
                     system has no broadcast for. -->
                <action android:name="com.em87.weirdclock.SKY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- And one apiece, so a home screen can hold more than one clock
             — see [FaceWidgets]. They share this one's drawing, its
             settings screen and its wake-ups; all they answer is which
             clock they are. -->

        <receiver
            android:name=".AnalogWidgetProvider"
            android:exported="false"
            android:label="@string/widget_dial_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.em87.weirdclock.SKY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dial_info" />
        </receiver>

        <receiver
            android:name=".DigitalWidgetProvider"
            android:exported="false"
            android:label="@string/widget_digits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.em87.weirdclock.SKY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_digits_info" />
        </receiver>

        <receiver
            android:name=".SundialWidgetProvider"
            android:exported="false"
            android:label="@string/widget_sundial_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.em87.weirdclock.SKY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sundial_info" />
        </receiver>

        <receiver
            android:name=".WorldWidgetProvider"
            android:exported="false"
            android:label="@string/widget_globe_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.em87.weirdclock.SKY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_globe_info" />
        </receiver>

        <receiver
            android:name=".OrreryWidgetProvider"
            android:exported="false"
            android:label="@string/widget_orrery_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The planets are drawn for a date, so the picture goes
                     stale when the date does. -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- And its own wake-up, since nothing on this dial moves
                     fast enough for the system to have a broadcast for. -->
                <action android:name="com.em87.weirdclock.ORRERY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_orrery_info" />
        </receiver>

        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="false"
            android:label="@string/widget_weather_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.em87.weirdclock.WEATHER_TICK" />
                <action android:name="com.em87.weirdclock.WEATHER_LOCATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name=".HourglassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_hourglass_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hourglass_info" />
        </receiver>
    </application>

</manifest>
