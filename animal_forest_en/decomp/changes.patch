+/* The line the index i is on */
+static s32 mHandbill_en_EditLineOf(s32* starts, s32 lines, s32 i) {
+    s32 line = lines - 1;
+
+    while (line > 0 && starts[line] > i) {
+        line--;
+    }
+    return line;
+}
+
+/* The editor's line, laid out over its text, the line it is on kept within the text's */
+static s32 mHandbill_en_EditLine(mED_Ovl_c* editorOvl, s32* starts, s32* lines) {
+    *lines = mHandbill_en_EditLines(editorOvl->inputStr, editorOvl->nowStrLen, starts);
+    return (editorOvl->line < *lines) ? editorOvl->line : *lines - 1;
+}
+
+/* func_80885AEC_jp: the column and line after the text's first n characters */
+void mHandbill_en_EditColLine(mED_Ovl_c* editorOvl, s16* col, s16* line, s32 n) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 k;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        /* the cartridge's */
+        u8* str = editorOvl->inputStr;
+        s32 prevCol = 0;
+        s32 i;
+
+        *line = 0;
+        *col = 0;
+        for (i = 0; i < n; i++, str++) {
+            if ((*str == mHandbill_EN_NEW_LINE) || (editorOvl->inputLength == *col + 1)) {
+                (*line)++;
+                prevCol = *col;
+                *col = -1;
+            }
+            (*col)++;
+        }
+        if ((*col == 0) && (editorOvl->maxLineNo == *line)) {
+            *line = *line - 1;
+            *col = prevCol + 1;
+        }
+        return;
+    }
+    /* the whole text: a word that goes on past n can carry n to the next line */
+    lines = mHandbill_en_EditLines(editorOvl->inputStr, (n > editorOvl->nowStrLen) ? n : editorOvl->nowStrLen, starts);
+    k = mHandbill_en_EditLineOf(starts, lines, n);
+    *line = k;
+    *col = n - starts[k];
+    /* past the last line, the cursor stays at its end, as the cartridge's does */
+    if ((*col == 0) && (k > 0) && (editorOvl->maxLineNo == k)) {
+        *line = k - 1;
+        *col = n - starts[k - 1];
+    }
+}
+
+/*
+ * func_80885DD4_jp: room for the character typed: the text, the character
+ * put in at the cursor, still ends on one of its lines (the cartridge's
+ * test, in a buffer of its own: the cartridge's holds 100 bytes, a letter's
+ * body and one more character are 193)
+ */
+s32 mHandbill_en_EditRoom(mED_Ovl_c* editorOvl) {
+    static u8 buf[mHandbill_EN_EDIT_BODY_LEN + 1];
+    s32 total = editorOvl->inputLength * editorOvl->maxLineNo;
+    u8* inputStr = editorOvl->inputStr;
+    s16 col;
+    s16 line;
+    s32 i;
+
+    if ((total == editorOvl->nowStrLen) || (total > mHandbill_EN_EDIT_BODY_LEN)) {
+        return FALSE;
+    }
+    for (i = 0; i < editorOvl->cursorIdx; i++) {
+        buf[i] = inputStr[i];
+    }
+    buf[i] = editorOvl->nowCode;
+    for (; i < total; i++) {
+        buf[i + 1] = inputStr[i];
+    }
+    editorOvl->inputStr = buf;
+    mHandbill_en_EditColLine(editorOvl, &col, &line, editorOvl->nowStrLen + 1);
+    editorOvl->inputStr = inputStr;
+    return line < editorOvl->maxLineNo;
+}
+
+/* func_80885A74_jp: the cursor's index from its line and column */
+void mHandbill_en_EditIndex(mED_Ovl_c* editorOvl) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 line;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        /* the cartridge's */
+        u8* str = editorOvl->inputStr;
+        s32 i;
+
+        line = editorOvl->line;
+        editorOvl->cursorIdx = 0;
+        while (line != 0) {
+            for (i = 0; i < editorOvl->inputLength; i++) {
+                if (*str == mHandbill_EN_NEW_LINE) {
+                    str++;
+                    i++;
+                    break;
+                }
+                str++;
+            }
+            editorOvl->cursorIdx += i;
+            line--;
+        }
+        editorOvl->cursorIdx += editorOvl->col;
+        return;
+    }
+    line = mHandbill_en_EditLine(editorOvl, starts, &lines);
+    editorOvl->cursorIdx = starts[line] + editorOvl->col;
+}
+
+/* func_80885CBC_jp: the length of the cursor's line, what ends it counted */
+s32 mHandbill_en_EditLineLen(mED_Ovl_c* editorOvl) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 line;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        /* the cartridge's */
+        u8* str = editorOvl->inputStr;
+        s32 rest = editorOvl->nowStrLen;
+        s32 len = editorOvl->inputLength;
+        s32 i;
+
+        line = editorOvl->line;
+        do {
+            for (i = 0; (i < len) && (i < rest); i++, str++) {
+                if (*str == mHandbill_EN_NEW_LINE) {
+                    str++;
+                    i++;
+                    break;
+                }
+            }
+            rest -= i;
+            line--;
+        } while (line >= 0);
+        return i;
+    }
+    line = mHandbill_en_EditLine(editorOvl, starts, &lines);
+    return ((line + 1 < lines) ? starts[line + 1] : editorOvl->nowStrLen) - starts[line];
+}
