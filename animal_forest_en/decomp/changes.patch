+#define mHandbill_EN_EXT_HEAD 2
+#define mHandbill_EN_EXT_RECORD_HEAD 7
+/* the letters a save holds: 4 pockets and 4 mailboxes of 10, the post office's 5 kept and 2 more */
+#define mHandbill_EN_SAVE_MAIL_NUM (PLAYER_NUM * mPr_INVENTORY_MAIL_COUNT + PLAYER_NUM * HOME_MAILBOX_SIZE + 5 + 2)
+#define mHandbill_EN_KEEP_MAIL_AT 0xEF6C /* code/6DA460.s func_800B67C0_jp: mMl_copy_mail into common_data + 0xEF6C */
