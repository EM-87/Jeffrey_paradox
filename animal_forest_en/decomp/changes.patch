+void mSM_en_adFirstTag(Game* game, s32 choose, f32 x, f32 y) {
+    u8* str = choose ? mSM_en_adChoose : mSM_en_adEmpty;
+    s32 len = choose ? UI_EN_AD_CHOOSE_LEN : UI_EN_AD_EMPTY_LEN;
+    s32 width = mFont_GetStringWidth((char*)str, len, TRUE);
+    f32 scaleX = (width > mSM_EN_AD_TEXT_W) ? (f32)mSM_EN_AD_TEXT_W / width : 1.0f;
+
+    func_80090E98_jp(game, str, len, (x + 160.0f) - (width * scaleX) / 2, 120.0f - (8.0f + y), 80, 80, 230, 255,
+                     FALSE, FALSE, scaleX, 1.0f, 0);
+}
+
+/*
+ * A letter's name in its tag (tag_ovl, func_80877B0C_jp). The cartridge draws
+ * three lines: the addressee's name and the word for "to" after it, what the
+ * letter is, and the sender's name and the word for "from" after it, each
+ * piece where the last ends (mMl_strlen of the name, times the width of a
+ * character). The GameCube draws what it is with "to" first, then the
+ * addressee, then "from" and the sender (mTG_init_tag_data_item_win_sub_mail_
+ * item). With the disc's words (UI_EN_FROM_GC) the en build draws the
+ * GameCube's order, a piece after another at the en font's widths; without
+ * them, the cartridge's. Drawn here because the overlay cannot grow; the
+ * overlay passes its own strings and colours, which code cannot name.
+ */
+#include "m_mail.h"
+
+/* tag_ovl's record of the letter, as far as its name is drawn */
+typedef struct mSM_EnTagMail {
+    /* 0x00 */ u8 unk_00[0x2];
+    /* 0x02 */ u8 type; /* 1 a delivery, 3 and 7 from someone named without the honorific (7 the player's
+                         * mother), 4 to such, 8 a fortune, 9 from the HRA */
+    /* 0x03 */ u8 unk_03[0x41];
+    /* 0x44 */ u8 to[0xA];
+    /* 0x4E */ u8 from[0x6];
+} mSM_EnTagMail;
+
+/* tag_ovl's strings from D_80878AC0_jp: a fortune, the HRA, a delivery, a letter, the word for "to" after a
+ * name (2 on: without the honorific), the word for "from" after one (2 on: without it) */
+#define mSM_EN_TG_FORTUNE 0x00
+#define mSM_EN_TG_HRA 0x04
+#define mSM_EN_TG_DELIVERY 0x0C
+#define mSM_EN_TG_LETTER 0x14
+#define mSM_EN_TG_TO 0x18
+#define mSM_EN_TG_FROM 0x1C
+/* and its colours from D_808794C0_jp, 4 bytes each (r, g, b) */
+#define mSM_EN_TG_COLOR(colors, i) (&(colors)[(i) * 4])
+
+u8 mSM_en_tgLetterTo[] = UI_EN_TG_LETTER_TO;
+u8 mSM_en_tgDeliveryFor[] = UI_EN_TG_DELIVERY_FOR;
+u8 mSM_en_tgFortune[] = UI_EN_TG_FORTUNE;
+u8 mSM_en_tgFrom[] = UI_EN_TG_FROM;
+u8 mSM_en_tgHra[] = UI_EN_TG_HRA;
+u8 mSM_en_tgHome[] = UI_EN_TG_HOME;
+
+/* The sender's colour, by the letter's type (func_80877B0C_jp's) */
+static u8* mSM_en_tgFromColor(u8* colors, s32 type) {
+    switch (type) {
+        case 9:
+        case 3:
+            return mSM_EN_TG_COLOR(colors, 2);
+        case 8:
+        case 6:
+            return mSM_EN_TG_COLOR(colors, 4);
+        case 5:
+            return mSM_EN_TG_COLOR(colors, 3);
+        case 7:
+            return mSM_EN_TG_COLOR(colors, 5);
+        default:
+            return mSM_EN_TG_COLOR(colors, 1);
+    }
+}
+
+void mSM_en_tagMailName(Game* game, u8* data, f32 x, f32 y, f32 scale, f32 charWidth, f32 lineHeight, u8* words,
+                        u8* colors) {
+    mSM_EnTagMail* tag = (mSM_EnTagMail*)data;
+    u8* toColor = (tag->type == 4) ? mSM_EN_TG_COLOR(colors, 2) : mSM_EN_TG_COLOR(colors, 0);
+    u8* fromColor = mSM_en_tgFromColor(colors, tag->type);
+    u8* str;
+    s32 len;
+
+    if (UI_EN_FROM_GC) {
+        /* what it is, with "to"; the addressee; "from" and the sender */
+        if (tag->type == 1) {
+            str = mSM_en_tgDeliveryFor;
+            len = UI_EN_TG_DELIVERY_FOR_LEN;
+        } else if (tag->type == 8) {
+            str = mSM_en_tgFortune;
+            len = UI_EN_TG_FORTUNE_LEN;
+        } else {
+            str = mSM_en_tgLetterTo;
+            len = UI_EN_TG_LETTER_TO_LEN;
+        }
+        func_80090E98_jp(game, str, len, x, y, 90, 60, 50, 255, FALSE, FALSE, scale, scale, 0);
+        y += lineHeight;
+        func_80090E98_jp(game, tag->to, 6, x, y, toColor[0], toColor[1], toColor[2], 255, FALSE, FALSE, scale, scale,
+                         0);
+        y += lineHeight;
+        func_80090E98_jp(game, mSM_en_tgFrom, UI_EN_TG_FROM_LEN, x, y, 90, 60, 50, 255, FALSE, FALSE, scale, scale, 0);
+        x += mFont_GetStringWidth((char*)mSM_en_tgFrom, UI_EN_TG_FROM_LEN, TRUE) * scale;
+        if (tag->type == 9) {
+            str = mSM_en_tgHra;
+            len = UI_EN_TG_HRA_LEN;
+        } else if (tag->type == 7) {
+            str = mSM_en_tgHome;
+            len = UI_EN_TG_HOME_LEN;
+        } else {
+            str = tag->from;
+            len = 6;
+        }
+        func_80090E98_jp(game, str, len, x, y, fromColor[0], fromColor[1], fromColor[2], 255, FALSE, FALSE, scale,
+                         scale, 0);
+        return;
+    }
+    /* the cartridge's order and pieces */
+    func_80090E98_jp(game, tag->to, 6, x, y, toColor[0], toColor[1], toColor[2], 255, FALSE, FALSE, scale, scale, 0);
+    func_80090E98_jp(game, &words[mSM_EN_TG_TO + ((tag->type == 4) ? 2 : 0)], (tag->type == 4) ? 2 : 4,
+                     x + mMl_strlen((char*)tag->to, 6, ' ') * charWidth, y, 90, 60, 50, 255, FALSE, FALSE, scale, scale,
+                     0);
+    y += lineHeight;
+    if (tag->type == 1) {
+        str = &words[mSM_EN_TG_DELIVERY];
+        len = 6;
+    } else if (tag->type == 8) {
+        str = &words[mSM_EN_TG_FORTUNE];
+        len = 4;
+    } else {
+        str = &words[mSM_EN_TG_LETTER];
+        len = 4;
+    }
+    func_80090E98_jp(game, str, len, x, y, 90, 60, 50, 255, FALSE, FALSE, scale, scale, 0);
+    y += lineHeight;
+    if (tag->type == 9) {
+        func_80090E98_jp(game, &words[mSM_EN_TG_HRA], 7, x, y, fromColor[0], fromColor[1], fromColor[2], 255, FALSE,
+                         FALSE, scale, scale, 0);
+        return;
+    }
+    func_80090E98_jp(game, tag->from, 6, x, y, fromColor[0], fromColor[1], fromColor[2], 255, FALSE, FALSE, scale,
+                     scale, 0);
+    if (tag->type != 8) {
+        s32 bare = (tag->type == 3) || (tag->type == 7);
+
+        func_80090E98_jp(game, &words[mSM_EN_TG_FROM + (bare ? 2 : 0)], bare ? 2 : 4,
+                         x + mMl_strlen((char*)tag->from, 6, ' ') * charWidth, y, 90, 60, 50, 255, FALSE, FALSE, scale,
+                         scale, 0);
+    }
+}
