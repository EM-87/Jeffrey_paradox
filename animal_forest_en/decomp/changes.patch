+typedef struct mFRm_en_hdr_t {
+    /* 0x00 */ u32 magic;    /* mFRm_EN_MAGIC */
+    /* 0x04 */ u32 saveComp; /* the save's stream, right after this header */
+    /* 0x08 */ u32 extSize;
+    /* 0x0C */ u32 extComp;  /* the extension's stream, after the save's */
+    /* 0x10 */ u32 extSum;   /* the extension's bytes added up */
+} mFRm_en_hdr_t; // size = 0x14
+
+typedef struct mFRm_en_Reader {
+    /* 0x00 */ u8* buf;   /* mFRm_en_Page() */
+    /* 0x04 */ u32 page;  /* the next page to read */
+    /* 0x08 */ s32 pos;   /* in buf */
+    /* 0x0C */ s32 left;  /* bytes of the stream still to come */
+    /* 0x10 */ s32 error; /* a page could not be read */
