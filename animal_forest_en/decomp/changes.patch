+/*
+ * The letters' extension (mFRm_en_ext, saved and loaded with the save:
+ * m_flashrom.c). Mail_c keeps a letter's first 10, 96 and 16 bytes; the
+ * rest of each letter the loaders make is filed here under a key made of
+ * those bytes, so a copy of the letter (mailbox to pocket, post office to
+ * mailbox) finds it, and before each save the records no letter of the
+ * save holds are dropped (mHandbill_en_CollectExt). The layout: "LX",
+ * then records, oldest first: the key (4 bytes, big-endian), the
+ * lengths of the header's, the body's and the footer's rest (a byte
+ * each, padding left off), the three rests. An extension without the
+ * tag is not ours: it is left as it is and read as empty.
+ */
+#define mHandbill_EN_EXT_HEAD 2
+#define mHandbill_EN_EXT_RECORD_HEAD 7
+/* the letters a save holds: 4 pockets and 4 mailboxes of 10, the post office's 5 kept and 2 more */
+#define mHandbill_EN_SAVE_MAIL_NUM (PLAYER_NUM * mPr_INVENTORY_MAIL_COUNT + PLAYER_NUM * HOME_MAILBOX_SIZE + 5 + 2)
+#define mHandbill_EN_KEEP_MAIL_AT 0xEF6C /* code/6DA460.s func_800B67C0_jp: mMl_copy_mail into common_data + 0xEF6C */
+#define mHandbill_EN_RECEIPT_MAIL0_AT 0xF2A0 /* code/6DA460.s mPO_receipt_proc */
+#define mHandbill_EN_RECEIPT_MAIL1_AT 0xF344
