+ * word-wrapped at the board's 192 pixels over its six lines, its newlines
+ * kept, the footer ending where the body's lines do. Writing one, it shows
+ * the header and footer being written (Mail_c's 10 and 16 bytes) and the
+ * body whole (mHandbill_en_editBody, 192 bytes), laid out the same way.
+ */
+#define mHandbill_EN_BOARD_WIDTH 192 /* mBD_MAX_WIDTH */
+#define mHandbill_EN_BOARD_LINES 6
+#define mHandbill_EN_NEW_LINE 0xCD
+#define mHandbill_EN_BOARD_FIELD_HEADER 0
