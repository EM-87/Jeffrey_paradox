+    for (i = 0; i < mHandbill_EN_FOOTER_LEN && board->footer[i] == ' '; i++) {}
+    for (j = 0; j < mHandbill_EN_FOOTER_LEN; j++) {
+        board->footer[j] = (i + j < mHandbill_EN_FOOTER_LEN) ? board->footer[i + j] : ' ';
