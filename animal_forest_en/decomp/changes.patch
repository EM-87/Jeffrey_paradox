+#ifndef M_BOARD_OVL_EN_H
+#define M_BOARD_OVL_EN_H
+
+/*
+ * The en build: the letter board's state and the text editor's, shared by
+ * the board (board_ovl), the editor (ovl__0078CB80), the bulletin board
+ * (ovl__00797A50) and the letters' code (m_handbill.c), which lays the
+ * letter or the post out and draws it. Its own header, included by those
+ * four files only: a type added to a shared header can move another file's
+ * bss.
+ */
+
+#include "ultra64.h"
+#include "color.h"
+#include "m_mail.h"
+
+struct Game;
+
+/* A letter's body or a notice while it is written, whole (m_handbill.c): the GameCube's 192 bytes, 32 characters
+   a line */
+#define mHandbill_EN_EDIT_BODY_LEN 192
+#define mHandbill_EN_EDIT_LINE_LEN 32
+extern u8 mHandbill_en_editBody[mHandbill_EN_EDIT_BODY_LEN];
+
+typedef struct mBD_Ovl_c {
+    /* 0x00 */ u8 field;
+    /* 0x01 */ u8 centerLine;
+    /* 0x02 */ u8 headerPos;
+    /* 0x03 */ u8 headerNameLen;
+    /* 0x04 */ u8 first;
