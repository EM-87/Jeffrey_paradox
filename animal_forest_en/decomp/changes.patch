+/* A stream of size bytes at offset in the slot at startPage; FALSE if its first page could not be read. */
+static s32 mFRm_en_Open(mFRm_en_Reader* r, u32 startPage, u32 offset, s32 size) {
+    r->buf = mFRm_en_Page();
+    r->page = startPage + offset / FLASH_BLOCK_SIZE;
+    r->pos = offset % FLASH_BLOCK_SIZE;
+    r->left = size;
