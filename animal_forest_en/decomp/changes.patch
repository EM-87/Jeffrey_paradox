+
+/* After a line up or down: the column nearest x, at most maxCol (the cartridge's keeps the column) */
+void mHandbill_en_EditSetCol(mED_Ovl_c* editorOvl, s32 x, s32 maxCol) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 line;
+    s32 best = 0;
+    s32 bestDist = x;
+    s32 width = 0;
+    s32 col;
+    u8* str;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        if (editorOvl->col > maxCol) {
