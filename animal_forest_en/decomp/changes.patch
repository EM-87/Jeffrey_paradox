+/* One line of the letter being read: up to the board's width, broken after its last space that fits */
+static s32 mHandbill_en_BoardLine(u8* str, s32 rest, s32* next) {
+    s32 width = 0;
+    s32 len = 0;
+    s32 space = -1;
+
+    while (len < rest && str[len] != mHandbill_EN_NEW_LINE) {
+        s32 w = func_8009028C_jp(str[len], TRUE);
+
+        if (str[len] == ' ') {
+            space = len;
+        }
+        if (len > 0 && width + w > mHandbill_EN_BOARD_WIDTH) {
+            if (space > 0) {
+                *next = space + 1;
+                return space;
+            }
+            *next = len;
+            return len;
+        }
+        width += w;
+        len++;
+    }
+    *next = (len < rest) ? len + 1 : len;
+    return len;
