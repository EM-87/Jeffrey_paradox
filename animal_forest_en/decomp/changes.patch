+static void mHandbill_en_GetParam(s32 entry, s32 cap, RomOffset* addr, s32* size) {
+    u64 buf64[2];
+    u32* buf = (u32*)buf64;
+    s32 start;
+    s32 len;
+
+    if (entry == 0) {
+        DmaMgr_RequestSyncDebug(buf, SEGMENT_ROM_START(mail_en_index), 2 * sizeof(u32), "../m_handbill.c", __LINE__);
+        start = 0;
+        len = buf[0];
+    } else if (entry & 1) {
+        DmaMgr_RequestSyncDebug(buf, SEGMENT_ROM_START(mail_en_index) + (entry - 1) * sizeof(u32), 2 * sizeof(u32),
+                                "../m_handbill.c", __LINE__);
+        start = buf[0];
+        len = buf[1] - start;
+    } else {
+        DmaMgr_RequestSyncDebug(buf, SEGMENT_ROM_START(mail_en_index) + (entry - 2) * sizeof(u32), 4 * sizeof(u32),
+                                "../m_handbill.c", __LINE__);
+        start = buf[1];
+        len = buf[2] - start;
+    }
+    if (len <= cap) {
+        *addr = SEGMENT_ROM_START(mail_en_text) + start;
+        *size = len;
+    } else {
+        *addr = 0;
+        *size = 0;
+    }
