+/*
+ * The en build: the menus' own words (strings a menu draws with the font from
+ * its own data, not from the text banks), the GameCube's, from the user's disc,
+ * or the cartridge's own without it (tools/af_ui.py). They are kept here, in
+ * code, because the menus' overlays cannot grow; the overlays' tables point
+ * here (reference/NOTES.md, "The menus' own words").
+ */
+#include "assets/jp/en/ui_strings.inc"
+#include "6B3DC0.h"
+
+/* The name entry's window titles (ledit_ovl's mLE_win_data) */
