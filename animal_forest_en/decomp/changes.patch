+void mHandbill_en_BoardBody(mBD_Ovl_c* boardOvl, s32 writing, struct Game* game, f32 x, f32* y, f32* endX, f32* endY,
+                            Color_RGBA8* color);
+void mHandbill_en_BoardFooter(mBD_Ovl_c* boardOvl, struct Game* game, f32 x, f32 y, Color_RGBA8* color);
+f32 mHandbill_en_BoardCursorX(mBD_Ovl_c* boardOvl, mED_Ovl_c* editorOvl);
+f32 mHandbill_en_BoardNameX(mBD_Ovl_c* boardOvl);
+void mHandbill_en_BoardNewLetter(mBD_Ovl_c* boardOvl, u8* name);
+
+void mHandbill_en_EditInit(mED_Ovl_c* editorOvl, s32 kind, s32 data1);
+s32 mHandbill_en_EditRoom(mED_Ovl_c* editorOvl);
+void mHandbill_en_EditColLine(mED_Ovl_c* editorOvl, s16* col, s16* line, s32 n);
+void mHandbill_en_EditIndex(mED_Ovl_c* editorOvl);
+s32 mHandbill_en_EditLineLen(mED_Ovl_c* editorOvl);
+s32 mHandbill_en_EditX(mED_Ovl_c* editorOvl);
+void mHandbill_en_EditSetCol(mED_Ovl_c* editorOvl, s32 x, s32 maxCol);
+
+u8* mHandbill_en_GetNotice(u8* post, s32* len);
+void mHandbill_en_NoticeText(s32 writing, struct Game* game, u8* str, s32 len, f32 x, f32 y, f32* endX, f32* endY);
+
