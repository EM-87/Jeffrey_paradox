+ * 0xF980 bytes, header and checksum included) and the letters' extension
+ * (mFRm_en_ext), each compressed with include/af_lz.h, then zeros; or,
+ * when the two do not fit in the slot, the save as the cartridge writes
+ * it. Reads take both, so the cartridge's saves load (without extension).
+ *
+ * Every write is of an image. The normal save and the gyroid's
+ * (func_8008F040_jp) borrow a framebuffer (func_800D97A0_jp: 0x25800
+ * bytes), which holds the image, the save's copy and the compressor's
+ * work; the save menu's write takes them from the game state's heap when
+ * it has room, and writes the cartridge's format when it has not (at a
+ * new game, where play holds the whole heap and nothing has an
+ * extension yet). The boot repair copies a slot's image as it is, and
+ * checks read back the image's pages. Reads decompress from the flash a
+ * page at a time.
+ */
+
+#define mFRm_EN_MAGIC 0x41465A31 /* "AFZ1" */
+#define mFRm_EN_SLOT_SIZE (mFRm_SLOT_PAGES * FLASH_BLOCK_SIZE) /* 0x10000 */
+/* the normal save's borrowed framebuffer: the image first (work->base), the save's copy, the work */
+#define mFRm_EN_COPY_AT mFRm_EN_SLOT_SIZE
+#define mFRm_EN_WORK_AT (mFRm_EN_COPY_AT + mFRm_SAVE_SIZE)
+#define mFRm_EN_BUF_SIZE (mFRm_EN_WORK_AT + sizeof(aflz_Work)) /* 0x23980, under func_800D97A0_jp's 0x25800 */
+
+typedef struct mFRm_en_hdr_t {
+    /* 0x00 */ u32 magic;    /* mFRm_EN_MAGIC */
+    /* 0x04 */ u32 saveComp; /* the save's stream, right after this header */
+    /* 0x08 */ u32 extSize;
+    /* 0x0C */ u32 extComp;  /* the extension's stream, after the save's */
+    /* 0x10 */ u32 extSum;   /* the extension's bytes added up */
+} mFRm_en_hdr_t; // size = 0x14
+
+typedef struct mFRm_en_Reader {
+    /* 0x00 */ u8* buf;   /* mFRm_en_Page() */
+    /* 0x04 */ u32 page;  /* the next page to read */
+    /* 0x08 */ s32 pos;   /* in buf */
+    /* 0x0C */ s32 left;  /* bytes of the stream still to come */
+    /* 0x10 */ s32 error; /* a page could not be read */
+} mFRm_en_Reader; // size = 0x14
+
+u8 mFRm_en_ext[mFRm_EN_EXT_CAP];
+s32 mFRm_en_extSize;
