+
+/* The translation's builders for the message substitutions (STR_YEAR..STR_SEC,
+ * STR_AMPM), in the GameCube's formats: "2001", "April", "Saturday", "14th",
+ * "5", "07", "09", "p.m.". dst holds at least mString_EN_LEN bytes. */
+s32 mString_en_HourNumber(char* dst, lbRTC_hour_t hour) {
+    s32 h = hour % 12;
+
+    if (h == 0) {
+        h = 12;
+    }
+    if (h >= 10) {
+        dst[0] = '1';
+        dst[1] = '0' + h - 10;
+        return 2;
+    }
+    dst[0] = '0' + h;
+    return 1;
+}
+
+static s32 mString_en_TwoDigits(char* dst, s32 value) {
+    dst[0] = '0' + (value / 10) % 10;
+    dst[1] = '0' + value % 10;
+    return 2;
+}
+
+s32 mString_en_Year(char* dst, lbRTC_year_t year) {
+    mem_clear((u8*)dst, mString_EN_LEN, ' ');
+    mFont_UnintToString(dst, year, 6, TRUE, FALSE);
+    return mMsg_Get_Length_String(dst, mString_EN_LEN);
+}
+
+s32 mString_en_Month(char* dst, lbRTC_month_t month) {
+    if (month < 1 || month > 12) {
+        month = 1;
+    }
+    mString_Load_StringFromRom(dst, mString_EN_LEN, mString_EN_MONTH_START + month - 1);
+    return mMsg_Get_Length_String(dst, mString_EN_LEN);
+}
+
+s32 mString_en_Week(char* dst, lbRTC_weekday_t weekday) {
+    if (weekday > 6) {
+        weekday = 0;
+    }
+    mString_Load_StringFromRom(dst, mString_EN_LEN, weekday + 9);
+    return mMsg_Get_Length_String(dst, mString_EN_LEN);
+}
+
+s32 mString_en_Day(char* dst, lbRTC_day_t day) {
+    if (day < 1 || day > 31) {
+        day = 1;
+    }
+    mString_Load_StringFromRom(dst, mString_EN_LEN, mString_EN_DAY_START + day - 1);
+    return mMsg_Get_Length_String(dst, mString_EN_LEN);
+}
+
+s32 mString_en_Hour(char* dst, lbRTC_hour_t hour) {
+    if (hour >= lbRTC_HOURS_PER_DAY) {
+        hour = 0;
+    }
+    mem_clear((u8*)dst, mString_EN_LEN, ' ');
+    return mString_en_HourNumber(dst, hour);
+}
+
+s32 mString_en_Min(char* dst, lbRTC_min_t min) {
+    if (min >= lbRTC_MINUTES_PER_HOUR) {
+        min = 0;
+    }
+    mem_clear((u8*)dst, mString_EN_LEN, ' ');
+    return mString_en_TwoDigits(dst, min);
+}
+
+s32 mString_en_Sec(char* dst, lbRTC_sec_t sec) {
+    if (sec >= 60) {
+        sec = 0;
+    }
+    mem_clear((u8*)dst, mString_EN_LEN, ' ');
+    return mString_en_TwoDigits(dst, sec);
+}
+
+s32 mString_en_AmPm(char* dst, lbRTC_hour_t hour) {
+    mString_Load_StringFromRom(dst, mString_EN_LEN, hour < 12 ? mString_AM : mString_PM);
+    return mMsg_Get_Length_String(dst, mString_EN_LEN);
+}
