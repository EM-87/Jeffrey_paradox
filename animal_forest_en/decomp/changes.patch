+/* Where the lines of str's first len characters start (a line after the last when it ends in a newline) */
+static s32 mHandbill_en_EditLines(u8* str, s32 len, s32* starts) {
+    s32 lines = 1;
+    s32 at = 0;
+
+    starts[0] = 0;
+    while (at < len && lines < mHandbill_EN_EDIT_LINES) {
+        s32 next;
