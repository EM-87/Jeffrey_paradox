+    /* 0x008 */ s32 headerLen;
+    /* 0x00C */ s32 bodyLen;
+    /* 0x010 */ s32 footerLen;
+    /* 0x014 */ u8 header[mHandbill_EN_HEADER_LEN];
+    /* 0x02C */ u8 body[mHandbill_EN_BODY_LEN];
