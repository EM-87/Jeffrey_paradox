+
+/* After a line up or down: the column nearest x, at most maxCol (the cartridge's keeps the column) */
+void mHandbill_en_EditSetCol(mED_Ovl_c* editorOvl, s32 x, s32 maxCol) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 line;
+    s32 best = 0;
+    s32 bestDist = x;
+    s32 width = 0;
+    s32 col;
+    u8* str;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        if (editorOvl->col > maxCol) {
+            editorOvl->col = maxCol;
+        }
+        return;
+    }
+    line = mHandbill_en_EditLine(editorOvl, starts, &lines);
+    str = &editorOvl->inputStr[starts[line]];
+    for (col = 1; col <= maxCol; col++) {
+        s32 dist;
+
+        width += func_8009028C_jp(str[col - 1], TRUE);
+        dist = ABS(width - x);
+        if (dist < bestDist) {
+            best = col;
+            bestDist = dist;
+        }
+    }
+    editorOvl->col = best;
+}
+
+/*
+ * A text laid out as it is written (mHandbill_en_EditLines) on the board's
+ * six lines from x, *y (*y left after the sixth), a line's newline drawn
+ * while it is written, as on the cartridge's boards; the end mark's place
+ * after its last character (from the screen's centre) in *endX, *endY
+ */
+static void mHandbill_en_DrawBody(Game* game, u8* str, s32 len, s32 writing, f32 x, f32* y, f32* endX, f32* endY,
+                                  Color_RGBA8* color) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines = mHandbill_en_EditLines(str, len, starts);
+    f32 top = *y;
+    s32 endLine = mHandbill_en_EditLineOf(starts, lines, len);
+    s32 i;
+
+    for (i = 0; i < mHandbill_EN_BOARD_LINES; i++) {
+        if (i < lines && starts[i] < len) {
+            s32 next;
+            s32 drawn = mHandbill_en_BoardLine(&str[starts[i]], len - starts[i], &next);
+
+            /* while it is written, a line's newline shows, as on the cartridge */
+            if (writing && starts[i] + drawn < len && str[starts[i] + drawn] == mHandbill_EN_NEW_LINE) {
+                drawn++;
+            }
+            if (drawn > 0) {
+                mHandbill_en_DrawLine(game, &str[starts[i]], drawn, x, *y, color);
+            }
+        }
+        *y += 16.0f;
+    }
+    if (endLine >= mHandbill_EN_BOARD_LINES) {
+        endLine = mHandbill_EN_BOARD_LINES - 1;
+    }
+    *endX = x + mHandbill_en_TextWidth(&str[starts[endLine]], len - starts[endLine]) - 160.0f;
+    *endY = 120.0f - (top + endLine * 16.0f);
+}
+
+void mHandbill_en_BoardBody(mBD_Ovl_c* boardOvl, s32 writing, Game* game, f32 x, f32* y, f32* endX, f32* endY,
+                            Color_RGBA8* color) {
+    s32 i;
+
+    if (mHandbill_en_board.reading) {
+        u8* str = mHandbill_en_board.body;
+        s32 rest = mHandbill_en_board.bodyLen;
+
+        for (i = 0; i < mHandbill_EN_BOARD_LINES; i++) {
+            s32 next = 0;
+            s32 len = (rest > 0) ? mHandbill_en_BoardLine(str, rest, &next) : 0;
+
+            if (len > 0) {
+                mHandbill_en_DrawLine(game, str, len, x, *y, color);
+            }
+            str += next;
+            rest -= next;
+            *y += 16.0f;
+        }
+        return;
+    }
+
+    mHandbill_en_DrawBody(game, mHandbill_en_editBody, boardOvl->lengths[mHandbill_EN_BOARD_FIELD_BODY], writing, x, y,
+                          endX, endY, color);
+}
+
+void mHandbill_en_BoardFooter(mBD_Ovl_c* boardOvl, Game* game, f32 x, f32 y, Color_RGBA8* color) {
+    if (mHandbill_en_board.reading) {
+        s32 len = mHandbill_en_board.footerLen;
+
+        x += mHandbill_EN_BOARD_WIDTH - mHandbill_en_TextWidth(mHandbill_en_board.footer, len);
+        mHandbill_en_DrawLine(game, mHandbill_en_board.footer, len, x, y, color);
+    } else {
+        s32 len = boardOvl->lengths[mHandbill_EN_BOARD_FIELD_FOOTER];
+
+        x += mHandbill_EN_BOARD_WIDTH - mHandbill_en_TextWidth(boardOvl->mail.content.footer, len);
+        mHandbill_en_DrawLine(game, boardOvl->mail.content.footer, len, x, y, color);
+    }
+}
+
+/* The editor's cursor on the board (func_80889878_jp): pixels from the text's left edge */
+f32 mHandbill_en_BoardCursorX(mBD_Ovl_c* boardOvl, mED_Ovl_c* editorOvl) {
+    MailContent* content = &boardOvl->mail.content;
+    s32 col = editorOvl->col;
+
+    if (boardOvl->field == mHandbill_EN_BOARD_FIELD_HEADER) {
+        s32 x = mHandbill_en_TextWidth(content->header, col);
+
+        /* after the name: the name as the header draws it while it is written */
+        if (boardOvl->headerPos == 2) {
+            x += mHandbill_en_TextWidth((u8*)boardOvl->mail.header.recipient.personalID.playerName, PLAYER_NAME_LEN);
+        }
+        return x;
+    } else if (boardOvl->field == mHandbill_EN_BOARD_FIELD_BODY) {
+        return mHandbill_en_EditX(editorOvl);
+    } else {
+        s32 len = boardOvl->lengths[mHandbill_EN_BOARD_FIELD_FOOTER];
+
+        return mHandbill_EN_BOARD_WIDTH - mHandbill_en_TextWidth(content->footer, len) +
+               mHandbill_en_TextWidth(content->footer, col);
+    }
+}
+
+/* The middle of the recipient's name in the header (func_8088973C_jp's box), from the text's left edge */
+f32 mHandbill_en_BoardNameX(mBD_Ovl_c* boardOvl) {
+    MailContent* content = &boardOvl->mail.content;
+
+    return mHandbill_en_TextWidth(content->header, content->headerBackStart) +
+           mHandbill_en_TextWidth((u8*)boardOvl->mail.header.recipient.personalID.playerName, PLAYER_NAME_LEN) / 2.0f;
+}
+
+/* A new letter's header and footer: the GameCube's "To " before the name, "from " before the writer's
+ * (ac-decomp's m_board_ovl.c: header_str, footer_str); the cartridge's put the name first */
+void mHandbill_en_BoardNewLetter(mBD_Ovl_c* boardOvl, u8* name) {
+    static u8 header[3] = { 'T', 'o', ' ' };
+    static u8 footer[5] = { 'f', 'r', 'o', 'm', ' ' };
