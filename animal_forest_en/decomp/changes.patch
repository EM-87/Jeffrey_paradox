+/* FNV-1a over the letter's own bytes */
+static u32 mHandbill_en_Key(u8* header, u8* body, u8* footer) {
+    u32 key = 0x811C9DC5;
+    s32 i;
+
+    for (i = 0; i < MAIL_HEADER_LEN; i++) {
+        key = (key ^ header[i]) * 0x01000193;
+    }
+    for (i = 0; i < MAIL_BODY_LEN; i++) {
+        key = (key ^ body[i]) * 0x01000193;
+    }
+    for (i = 0; i < MAIL_FOOTER_LEN; i++) {
+        key = (key ^ footer[i]) * 0x01000193;
+    }
+    return key;
