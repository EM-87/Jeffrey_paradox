+    board->headerBackStart = mail->content.headerBackStart;
+    if (board->headerBackStart > mHandbill_EN_HEADER_LEN) {
+        board->headerBackStart = mHandbill_EN_HEADER_LEN;
+    }
+    board->headerLen = mMl_strlen((char*)board->header, mHandbill_EN_HEADER_LEN, ' ');
+    if (board->headerLen < board->headerBackStart) {
+        board->headerLen = board->headerBackStart;
+    }
+    for (i = mHandbill_EN_BODY_LEN; i > 0; i--) {
