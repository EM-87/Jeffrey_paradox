+    if (!mHandbill_en_ExtOurs()) {
+        return NULL;
+    }
+    while ((record = mHandbill_en_Record(pos)) != NULL) {
+        if (mHandbill_en_RecordKey(record) == key) {
+            return record;
+        }
+        pos += mHandbill_en_RecordSize(record);
+    }
+    return NULL;
