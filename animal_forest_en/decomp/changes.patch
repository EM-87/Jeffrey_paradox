+        pos + mHandbill_en_RecordSize(&mFRm_en_ext[pos]) > mFRm_en_extSize) {
+        return NULL;
+    }
+    return &mFRm_en_ext[pos];
+}
+
+static u8* mHandbill_en_Find(u32 key) {
+    s32 pos = mHandbill_EN_EXT_HEAD;
+    u8* record;
