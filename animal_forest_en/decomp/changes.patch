+/* The cursor's x in its line, in pixels (its column, for a text of 12-pixel columns) */
+s32 mHandbill_en_EditX(mED_Ovl_c* editorOvl) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 line;
+    s32 next;
+    s32 drawn;
+    u8* str;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        return editorOvl->col;
+    }
+    line = mHandbill_en_EditLine(editorOvl, starts, &lines);
+    str = &editorOvl->inputStr[starts[line]];
+    drawn = (starts[line] < editorOvl->nowStrLen)
+                ? mHandbill_en_BoardLine(str, editorOvl->nowStrLen - starts[line], &next)
+                : 0;
+    return mHandbill_en_TextWidth(str, (editorOvl->col < drawn) ? editorOvl->col : drawn);
