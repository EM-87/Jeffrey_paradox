+
+/* The streams' sizes stay inside the slot. */
+static s32 mFRm_en_Fits(mFRm_en_hdr_t* hdr) {
+    return hdr->saveComp <= mFRm_EN_SLOT_SIZE - sizeof(mFRm_en_hdr_t) &&
+           hdr->extComp <= mFRm_EN_SLOT_SIZE - sizeof(mFRm_en_hdr_t) - hdr->saveComp;
