+    /* 0x08 */ Mail_c mail;
+    /* 0xAC */ Mail_c* dst;
+    /* 0xB0 */ f32 ofsX;
+    /* 0xB4 */ f32 ofsY;
+    /* 0xB8 */ s32 unk_B8;
+    /* 0xBC */ s32 unk_BC;
+} mBD_Ovl_c; // size = 0xC0
+
+/* The text editor's state (submenu program 10, ovl__0078CB80) */
+typedef struct mED_Ovl_c {
+    /* 0x00 */ u8 stickArea;
+    /* 0x01 */ u8 unk_01;
+    /* 0x02 */ u8 unk_02;
+    /* 0x03 */ u8 unk_03;
+    /* 0x04 */ u8 unk_04;
+    /* 0x05 */ u8 inputMode;
+    /* 0x06 */ s16 unk_06;
+    /* 0x08 */ s32 lastButtons;
+    /* 0x0C */ s16 unk_0C;
+    /* 0x0E */ u8 unk_0E;
+    /* 0x0F */ u8 unk_0F;
+    /* 0x10 */ u8 unk_10;
+    /* 0x11 */ u8 command;
+    /* 0x12 */ u8 unk_12;
+    /* 0x13 */ u8 nowCode;
+    /* 0x14 */ u8 unk_14;
+    /* 0x15 */ u8 commandProcessed;
+    /* 0x16 */ s16 cursorIdx;
+    /* 0x18 */ s16 inputLength; /* characters a line */
+    /* 0x1A */ s16 maxLineNo;
+    /* 0x1C */ s16 nowStrLen;
+    /* 0x1E */ s16 exchangeCode;
+    /* 0x20 */ s16 col;
+    /* 0x22 */ s16 line;
+    /* 0x24 */ u8* inputStr;
+    /* 0x28 */ void* endCodeDraw;
+    /* 0x2C */ void* cursolDraw;
+} mED_Ovl_c; // size = 0x30
+
+void mHandbill_en_BoardLoad(mBD_Ovl_c* boardOvl, Mail_c* mail, s32 kind);
