+
+/*
+ * Writing a letter: the editor (submenu program 10) and the board lay its
+ * body out as it will be read, lines broken by mHandbill_en_BoardLine at the
+ * board's 192 pixels after the last space that fits, its own newlines kept
+ * (ac-decomp's editor breaks lines by width too: mED_get_col_line_width).
+ * The editor's line and column are a place in those lines, the cursor's x
+ * the width of its line up to it, and a line up or down keeps that x. The
+ * cartridge's editor counts lines of 16 characters (func_80885AEC_jp); it
+ * still does for every other text (a notice, a name), and for a letter's
+ * header and footer, single lines whose columns the board turns into
+ * pixels (mHandbill_en_BoardCursorX).
+ */
+#define mHandbill_EN_EDIT_LINES 8 /* more than a body's six: a text with one more character is tried */
+
+static s32 mHandbill_en_editLetter;
+
+/*
+ * The editor's init (kind and data1: its menu info's data0, the text's kind,
+ * and data1, the characters a line it was given): whether the text is a
+ * letter's (kind 0, with the board), and a letter's body whole in lines of
+ * 32 characters, its length measured over the 192 bytes when the init
+ * measured the 96 (the address book gives 16 a line; the board, writing on,
+ * none, and the body's length)
+ */
+void mHandbill_en_EditInit(mED_Ovl_c* editorOvl, s32 kind, s32 data1) {
+    mHandbill_en_editLetter = (kind == 0);
+    if (editorOvl->inputStr == mHandbill_en_editBody) {
+        editorOvl->inputLength = mHandbill_EN_EDIT_LINE_LEN;
+        if (data1 > 0) {
+            editorOvl->nowStrLen = mMl_strlen((char*)mHandbill_en_editBody, mHandbill_EN_EDIT_BODY_LEN, ' ');
+        }
+    }
+}
+
+static s32 mHandbill_en_EditLaidOut(mED_Ovl_c* editorOvl) {
+    return mHandbill_en_editLetter && (editorOvl->maxLineNo > 1);
+}
+
+/* Where the lines of str's first len characters start (a line after the last when it ends in a newline) */
+static s32 mHandbill_en_EditLines(u8* str, s32 len, s32* starts) {
+    s32 lines = 1;
+    s32 at = 0;
+
+    starts[0] = 0;
+    while (at < len && lines < mHandbill_EN_EDIT_LINES) {
+        s32 next;
+
+        mHandbill_en_BoardLine(&str[at], len - at, &next);
+        at += next;
+        if (at < len || str[at - 1] == mHandbill_EN_NEW_LINE) {
+            starts[lines++] = at;
+        }
+    }
+    return lines;
+}
+
+/* The line the index i is on */
+static s32 mHandbill_en_EditLineOf(s32* starts, s32 lines, s32 i) {
+    s32 line = lines - 1;
+
+    while (line > 0 && starts[line] > i) {
+        line--;
+    }
+    return line;
+}
+
+/* The editor's line, laid out over its text, the line it is on kept within the text's */
+static s32 mHandbill_en_EditLine(mED_Ovl_c* editorOvl, s32* starts, s32* lines) {
+    *lines = mHandbill_en_EditLines(editorOvl->inputStr, editorOvl->nowStrLen, starts);
+    return (editorOvl->line < *lines) ? editorOvl->line : *lines - 1;
+}
+
+/* func_80885AEC_jp: the column and line after the text's first n characters */
+void mHandbill_en_EditColLine(mED_Ovl_c* editorOvl, s16* col, s16* line, s32 n) {
+    s32 starts[mHandbill_EN_EDIT_LINES];
+    s32 lines;
+    s32 k;
+
+    if (!mHandbill_en_EditLaidOut(editorOvl)) {
+        /* the cartridge's */
+        u8* str = editorOvl->inputStr;
+        s32 prevCol = 0;
+        s32 i;
+
+        *line = 0;
+        *col = 0;
+        for (i = 0; i < n; i++, str++) {
+            if ((*str == mHandbill_EN_NEW_LINE) || (editorOvl->inputLength == *col + 1)) {
+                (*line)++;
+                prevCol = *col;
+                *col = -1;
+            }
+            (*col)++;
+        }
+        if ((*col == 0) && (editorOvl->maxLineNo == *line)) {
+            *line = *line - 1;
+            *col = prevCol + 1;
+        }
+        return;
+    }
+    /* the whole text: a word that goes on past n can carry n to the next line */
+    lines = mHandbill_en_EditLines(editorOvl->inputStr, (n > editorOvl->nowStrLen) ? n : editorOvl->nowStrLen, starts);
+    k = mHandbill_en_EditLineOf(starts, lines, n);
+    *line = k;
+    *col = n - starts[k];
+    /* past the last line, the cursor stays at its end, as the cartridge's does */
+    if ((*col == 0) && (k > 0) && (editorOvl->maxLineNo == k)) {
+        *line = k - 1;
+        *col = n - starts[k - 1];
+    }
