diff --git a/include/af_lz.h b/include/af_lz.h
new file mode 100644
index 0000000..0faf26b
--- /dev/null
+++ b/include/af_lz.h
@@ -0,0 +1,210 @@
+#ifndef AF_LZ_H
+#define AF_LZ_H
+
+/*
+ * The translation's compressor for the save (reference/NOTES.md, "The
+ * compressed save"): LZSS in Yaz0's encoding (a group byte for 8 items,
+ * MSB first; a set bit is a literal byte, a clear one a back-reference of
+ * 2 bytes, length 3-17, or 3 bytes, length 18-0x111, within 0x1000 bytes),
+ * greedy, with hash chains limited to the window. Header-only and free of
+ * the game's headers, so that tools/aflz.py's twin and a host test build
+ * the same code: the caller supplies the work area (aflz_Work, 16 KB).
+ * Inputs are shorter than 0xFFFF bytes (positions fit in 16 bits).
+ */
+
+#define AFLZ_WINDOW 0x1000
+#define AFLZ_MAX_LEN 0x111
+#define AFLZ_HASH_SIZE 0x1000
+#define AFLZ_CHAIN 32
+#define AFLZ_NONE 0xFFFF
+#define AFLZ_MAX_INPUT 0xFFFF
+
+typedef struct aflz_Work {
+    unsigned short head[AFLZ_HASH_SIZE];   /* last position of each 3-byte hash, AFLZ_NONE for none */
+    unsigned short prevDist[AFLZ_WINDOW];  /* distance to the previous position with the same hash, 0 for none */
+} aflz_Work;
+
+/* The next byte of a stream (0-255), or -1 at its end or on an error. */
+typedef int (*aflz_GetFn)(void* ctx);
+
+typedef struct aflz_Mem {
+    const unsigned char* p;
+    int left;
+} aflz_Mem;
+
+static unsigned int aflz_hash(const unsigned char* p) {
+    return ((p[0] << 4) ^ (p[1] << 2) ^ p[2]) & (AFLZ_HASH_SIZE - 1);
+}
+
+static void aflz_insert(aflz_Work* work, const unsigned char* src, int pos, int size) {
+    unsigned int h;
+    int prev;
+
+    if (pos + 3 > size) {
+        return;
+    }
+    h = aflz_hash(&src[pos]);
+    prev = work->head[h];
+    work->prevDist[pos & (AFLZ_WINDOW - 1)] =
+        (prev != AFLZ_NONE && pos - prev < AFLZ_WINDOW) ? (pos - prev) : 0;
+    work->head[h] = pos;
+}
+
+/* Compressed size, or -1 if it would pass cap (or size is too big). */
+static int aflz_compress(const unsigned char* src, int size, unsigned char* dst, int cap, aflz_Work* work) {
+    int i, out = 0, pos = 0;
+
+    if (size >= AFLZ_MAX_INPUT) {
+        return -1;
+    }
+    for (i = 0; i < AFLZ_HASH_SIZE; i++) {
+        work->head[i] = AFLZ_NONE;
+    }
+    for (i = 0; i < AFLZ_WINDOW; i++) {
+        work->prevDist[i] = 0;
+    }
+
+    while (pos < size) {
+        int groupAt = out, bit;
+        unsigned char flags = 0;
+
+        if (out + 1 > cap) {
+            return -1;
+        }
+        dst[out++] = 0;
+        for (bit = 0; bit < 8 && pos < size; bit++) {
+            int bestLen = 0, bestDist = 0;
+
+            if (pos + 3 <= size) {
+                int cand = work->head[aflz_hash(&src[pos])];
+                int steps = 0;
+
+                while (cand != AFLZ_NONE && pos - cand <= AFLZ_WINDOW && steps < AFLZ_CHAIN) {
+                    int len = 0, d;
+
+                    while (len < AFLZ_MAX_LEN && pos + len < size && src[cand + len] == src[pos + len]) {
+                        len++;
+                    }
+                    if (len > bestLen) {
+                        bestLen = len;
+                        bestDist = pos - cand;
+                        if (len == AFLZ_MAX_LEN) {
+                            break;
+                        }
+                    }
+                    d = work->prevDist[cand & (AFLZ_WINDOW - 1)];
+                    if (d == 0) {
+                        break;
+                    }
+                    cand -= d;
+                    steps++;
+                }
+            }
+            if (bestLen >= 3) {
+                int dist = bestDist - 1, k;
+
+                if (bestLen < 0x12) {
+                    if (out + 2 > cap) {
+                        return -1;
+                    }
+                    dst[out++] = ((bestLen - 2) << 4) | (dist >> 8);
+                    dst[out++] = dist & 0xFF;
+                } else {
+                    if (out + 3 > cap) {
+                        return -1;
+                    }
+                    dst[out++] = dist >> 8;
+                    dst[out++] = dist & 0xFF;
+                    dst[out++] = bestLen - 0x12;
+                }
+                for (k = 0; k < bestLen; k++) {
+                    aflz_insert(work, src, pos + k, size);
+                }
+                pos += bestLen;
+            } else {
+                if (out + 1 > cap) {
+                    return -1;
+                }
+                flags |= 0x80 >> bit;
+                dst[out++] = src[pos];
+                aflz_insert(work, src, pos, size);
+                pos++;
+            }
+        }
+        dst[groupAt] = flags;
+    }
+    return out;
+}
+
+/*
+ * 1 when dstSize bytes come out of the stream, 0 if it ends early, fails
+ * or points outside what has come out. Reads no further than it needs;
+ * whether the stream had exactly that many bytes is the caller's check.
+ */
+static int aflz_decompress_get(aflz_GetFn get, void* ctx, unsigned char* dst, int dstSize) {
+    int out = 0;
+
+    while (out < dstSize) {
+        int flags = get(ctx), bit;
+
+        if (flags < 0) {
+            return 0;
+        }
+        for (bit = 0; bit < 8 && out < dstSize; bit++) {
+            if (flags & (0x80 >> bit)) {
+                int c = get(ctx);
+
+                if (c < 0) {
+                    return 0;
+                }
+                dst[out++] = c;
+            } else {
+                int b0 = get(ctx), b1, len, from;
+
+                if (b0 < 0 || (b1 = get(ctx)) < 0) {
+                    return 0;
+                }
+                from = out - (((b0 & 0xF) << 8 | b1) + 1);
+                len = b0 >> 4;
+                if (len == 0) {
+                    int b2 = get(ctx);
+
+                    if (b2 < 0) {
+                        return 0;
+                    }
+                    len = b2 + 0x12;
+                } else {
+                    len += 2;
+                }
+                if (from < 0 || out + len > dstSize) {
+                    return 0;
+                }
+                while (len-- > 0) {
+                    dst[out++] = dst[from++];
+                }
+            }
+        }
+    }
+    return 1;
+}
+
+static int aflz_mem_get(void* ctx) {
+    aflz_Mem* mem = (aflz_Mem*)ctx;
+
+    if (mem->left <= 0) {
+        return -1;
+    }
+    mem->left--;
+    return *mem->p++;
+}
+
+/* 1 when exactly dstSize bytes come out of exactly srcSize bytes, 0 otherwise. */
+static int aflz_decompress(const unsigned char* src, int srcSize, unsigned char* dst, int dstSize) {
+    aflz_Mem mem;
+
+    mem.p = src;
+    mem.left = srcSize;
+    return aflz_decompress_get(aflz_mem_get, &mem, dst, dstSize) && mem.left == 0;
+}
+
+#endif
