+static s32 mHandbill_en_ExtOurs(void) {
+    return mFRm_en_extSize >= mHandbill_EN_EXT_HEAD && mFRm_en_ext[0] == 'L' && mFRm_en_ext[1] == 'X';
+}
+
+static s32 mHandbill_en_RecordSize(u8* record) {
+    return mHandbill_EN_EXT_RECORD_HEAD + record[4] + record[5] + record[6];
+}
+
+static u32 mHandbill_en_RecordKey(u8* record) {
+    return (record[0] << 24) | (record[1] << 16) | (record[2] << 8) | record[3];
