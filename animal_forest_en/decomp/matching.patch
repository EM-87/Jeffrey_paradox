+void mMsg_Set_mail_str(MessageWindow* msg, s32 mailStrNo, char* str, s32 strLen) {
+    if (mailStrNo >= 0 && mailStrNo < mMsg_MAIL_STR_NUM && str != NULL) {
+        s32 src;
+        s32 dst;
+        char* dstP;
+        char* srcP;
+        s32 rows;
+        s32 width;
+
+        if (strLen > mMsg_MAIL_STRING_LEN) {
+            strLen = mMsg_MAIL_STRING_LEN;
+        }
+
+        dst = 0;
+        dstP = (char*)msg->mailStr[mailStrNo];
+        srcP = str;
+        rows = 0;
+        width = 0;
+
+        for (src = 0; src < strLen; src++) {
+            u8 c = *srcP++;
+
+            if (c == mMsg_CHAR_NEW_LINE) {
+                rows++;
+                *dstP++ = c;
+                dst++;
+                width = 0;
+
+                if (dst >= mMsg_MAIL_STRING_LEN || rows >= mMsg_MAIL_LINES_MAX) {
+                    break;
+                }
+            } else {
+                *dstP++ = c;
+                dst++;
+                width++;
+
+                if (dst >= mMsg_MAIL_STRING_LEN) {
+                    break;
+                } else if (width >= mMsg_MAIL_LINE_WIDTH) {
+                    rows++;
+                    *dstP++ = mMsg_CHAR_NEW_LINE;
+                    dst++;
+                    width = 0;
+
+                    if (dst >= mMsg_MAIL_STRING_LEN || rows >= mMsg_MAIL_LINES_MAX) {
+                        break;
+                    }
+                }
+            }
+        }
+
+        for (; dst < mMsg_MAIL_STRING_LEN; dst++) {
+            *dstP++ = mMsg_CHAR_SPACE;
+        }
+    }
+}
