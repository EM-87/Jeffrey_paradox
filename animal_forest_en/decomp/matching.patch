+/*
+ * The message window. Laid out after the GameCube's mMsg_Window_c
+ * (ac-decomp include/m_msg.h), with every offset traced from the N64 code
+ * that uses it; fields named unk_ are not identified yet. Smaller than the
+ * GameCube's: names and item names hold 10 bytes (16 there), the mail
+ * string 0x44 (132 there), and there are no English articles.
+ */
+
+#define mMsg_FREE_STR_NUM 20
+#define mMsg_FREE_STRING_LEN 10
+#define mMsg_ITEM_STR_NUM 5
+#define mMsg_ITEM_STRING_LEN 10
+#define mMsg_MAIL_STR_NUM 1
+#define mMsg_MAIL_STRING_LEN 0x44
+#define mMsg_MAIL_LINE_WIDTH 16 /* characters before a forced new line */
+#define mMsg_MAIL_LINES_MAX 5
+#define mMsg_MAX_LINE 4
+
+#define mMsg_MODE_FONT 1 /* draw into the font display list (else the opaque one) */
+
+#define mMsg_CHAR_SPACE 0x20
+#define mMsg_CHAR_NEW_LINE 0xCD
+#define mMsg_CHAR_CONTROL 0x7F
+#define mMsg_CHAR_HYPHEN 0x90
+#define mMsg_CHAR_MESSAGE_TAG 0x80 /* skipped by the cursor, silent (func_8009F730_jp) */
+
+/* The message bank: 0x2DE8 messages, an index of u32 offsets at ROM
+ * 0xCF9000 and the text at ROM 0xBD4000; a message longer than
+ * mMsg_MSG_SIZE_MAX bytes is refused (func_8009E388_jp). */
+#define mMsg_MSG_NUM 0x2DE8
+#define mMsg_MSG_SIZE_MAX 0x400
+
+/* Control codes: mMsg_CHAR_CONTROL, then one of these, then arguments.
+ * Numbered as the N64 code reads them (the GameCube's differ). */
+#define mMsg_CODE_LAST 0x00
+#define mMsg_CODE_CONTINUE 0x01
+#define mMsg_CODE_CURSOR_SET_TIME 0x03
+#define mMsg_CODE_COLOR 0x05
+#define mMsg_CODE_SET_DEMO_ORDER_PLAYER 0x08
+#define mMsg_CODE_SET_DEMO_ORDER_NPC0 0x09
+#define mMsg_CODE_SET_DEMO_ORDER_NPC1 0x0A
+#define mMsg_CODE_SET_DEMO_ORDER_NPC2 0x0B
+#define mMsg_CODE_SET_DEMO_ORDER_QUEST 0x0C
+#define mMsg_CODE_SET_SELECT_WINDOW 0x0D
+#define mMsg_CODE_SOUND_CUT 0x51
+#define mMsg_CODE_BGM_MAKE 0x56
+#define mMsg_CODE_BGM_DELETE 0x57
+#define mMsg_CODE_MSG_TIME_END 0x58
+#define mMsg_CODE_SOUND_TRG_SYS 0x59
+#define mMsg_CODE_NUM 0x61 /* the handler table's size (func_800A21C0_jp) */
+
+/* Status flags, numbered as the GameCube's (those traced so far). */
+#define mMsg_STATUS_FLAG_SOUND_CUT (1 << 0) /* func_8009F8AC_jp */
+#define mMsg_STATUS_FLAG_NO_SE_PAGE_OKURI (1 << 1) /* func_800A01C8_jp */
+#define mMsg_STATUS_FLAG_NO_ZOOMUP (1 << 2) /* func_800A2784_jp */
+#define mMsg_STATUS_FLAG_LAST_DELAY (1 << 3) /* func_800A05D8_jp */
+#define mMsg_STATUS_FLAG_SPEC_VOICE (1 << 4) /* func_8009FCE0_jp */
+#define mMsg_STATUS_FLAG_VOICE_ENTRY (1 << 5) /* func_8009F830_jp */
+#define mMsg_STATUS_FLAG_IDLING_REQ (1 << 6)
+#define mMsg_STATUS_FLAG_IDLING_NOW (1 << 7)
+#define mMsg_STATUS_FLAG_FAST_TEXT (1 << 8) /* func_800A06AC_jp */
+
+#define mMsg_BGM_NUM 8
+#define mMsg_BGM_STOP_TYPE_NUM 3
+#define mMsg_SE_NUM 7
+
+#define mMsg_BUTTON_TURN_TIME 30.0f /* frames per blink of the continue button */
+
+/* What a control code handler returns to the cursor (m_msg_cursol in AC GCN). */
+typedef enum mMsg_RESULT {
+    /* 0 */ mMsg_RESULT_VOID,  /* go on typing */
+    /* 1 */ mMsg_RESULT_FALSE, /* stop here this frame, the code is done */
+    /* 2 */ mMsg_RESULT_TRUE   /* stop here, waiting */
+} mMsg_RESULT;
+
+#define mChoice_CHOICE_NUM 4 /* choices in a select window (6 on the GameCube) */
+
+typedef enum mMsg_INDEX {
+    /* 0 */ mMsg_INDEX_HIDE,
+    /* 1 */ mMsg_INDEX_APPEAR,
+    /* 2 */ mMsg_INDEX_NORMAL,
+    /* 3 */ mMsg_INDEX_CURSOL,
+    /* 4 */ mMsg_INDEX_DISAPPEAR,
+    /* 5 */ mMsg_INDEX_APPEAR_WAIT,
+    /* 6 */ mMsg_INDEX_WAIT,
+    /* 7 */ mMsg_INDEX_DISAPPEAR_WAIT,
+    /* 8 */ mMsg_INDEX_NUM
+} mMsg_INDEX;
+
+typedef struct mMsg_Request_MainAppear_Data {
+    /* 0x0 */ struct Actor* speakerActor;
+    /* 0x4 */ s32 msgNo;
+    /* 0x8 */ s32 nameShownFlag;
+    /* 0xC */ Color_RGBA8 windowColor;
+} mMsg_Request_MainAppear_Data; // size = 0x10
+
+typedef struct mMsg_Request_MainAppearWait_Data {
+    /* 0x0 */ s32 lastMainIndex;
+    /* 0x4 */ u32 setupFlag;
+} mMsg_Request_MainAppearWait_Data;
+
+typedef struct mMsg_Request_Index_Data {
+    /* 0x0 */ s32 value; /* last main index, or wait flag */
+} mMsg_Request_Index_Data;
+
+typedef union mMsg_Request_Data {
+    mMsg_Request_MainAppear_Data mainAppear;
+    mMsg_Request_MainAppearWait_Data mainAppearWait;
+    mMsg_Request_Index_Data mainIndex;
+    u64 align;
+} mMsg_Request_Data; // size = 0x10
+
+typedef union mMsg_Main_Data {
+    s32 savedMainIndex;
+    u64 align;
+} mMsg_Main_Data; // size = 0x8
+
+typedef struct mMsg_Data {
+    /* 0x0 */ s32 dataLoaded;
+    /* 0x4 */ s32 msgNo;
+    /* 0x8 */ s32 msgLen;
+    /* 0xC */ s32 cut;
+    /* 0x10 */ u8 text[1]; /* TODO(verify) size: messages are at most 0x400 bytes (func_8009E388_jp) */
+} mMsg_Data;
