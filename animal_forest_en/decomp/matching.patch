+    /* 0x4 */ s32 msgNo;
+    /* 0x8 */ s32 nameShownFlag;
+    /* 0xC */ Color_RGBA8 windowColor;
+} mMsg_Request_MainAppear_Data; // size = 0x10
+
+typedef struct mMsg_Request_MainAppearWait_Data {
+    /* 0x0 */ s32 lastMainIndex;
+    /* 0x4 */ u32 setupFlag;
+} mMsg_Request_MainAppearWait_Data;
+
+typedef struct mMsg_Request_Index_Data {
+    /* 0x0 */ s32 value; /* last main index, or wait flag */
+} mMsg_Request_Index_Data;
+
+typedef union mMsg_Request_Data {
+    mMsg_Request_MainAppear_Data mainAppear;
+    mMsg_Request_MainAppearWait_Data mainAppearWait;
+    mMsg_Request_Index_Data mainIndex;
+    u64 align;
+} mMsg_Request_Data; // size = 0x10
+
+typedef union mMsg_Main_Data {
+    s32 savedMainIndex;
+    u64 align;
+} mMsg_Main_Data; // size = 0x8
+
+typedef struct mMsg_Data {
+    /* 0x0 */ s32 dataLoaded;
+    /* 0x4 */ s32 msgNo;
+    /* 0x8 */ s32 msgLen;
+    /* 0xC */ s32 cut;
+    /* 0x10 */ u8 text[1]; /* TODO(verify) size: messages are at most 0x400 bytes (func_8009E388_jp) */
+} mMsg_Data;
