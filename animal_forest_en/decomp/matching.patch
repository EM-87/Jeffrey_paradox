+/* common_data.clip.handOverItemClip (m_clip.h leaves it incomplete: a new
+ * type there reorders other files' bss under IDO) */
+struct HandOverItemClip {
+    /* 0x00 */ UNK_TYPE1 unk_00[0x10];
+    /* 0x10 */ struct Actor* masterActor; /* the actor handing the item over, or NULL */
+}; // size >= 0x14
+
+extern mMsg_Data B_80141FF0_jp; /* the message being shown: 0x10 bytes, then 0x410 of text */
+extern MessageWindow B_80142410_jp; /* the message window */
+extern u8 D_BD4000[]; /* ROM: the message text */
+extern u8 D_80107B70_jp[6]; /* 0x7F, colour code, r, g, b, length: the player's name */
+extern u8 D_80107B78_jp[][3]; /* the colours free strings 1, 2 and 5 can take */
+extern u8 D_80107B88_jp[6]; /* 0x7F, colour code, r, g, b, length: a coloured free string */
+extern u8 D_CF9000[]; /* ROM: the message index */
+
+
+MessageWindow* mMsg_Get_base_window_p(void) {
+    return &B_80142410_jp;
+}
+
+s32 func_8009D200_jp(MessageWindow* msg, s32 priority) {
+    s32 requested = msg->requestedPriority;
+
+    return priority > requested;
+}
+
+s32 func_8009D210_jp(MessageWindow* msg, s32 index, s32 priority) {
+    if (func_8009D200_jp(msg, priority)) {
+        msg->requestedMainIndex = index;
+        msg->requestedPriority = priority;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+s32 mMsg_Check_main_index(MessageWindow* msg, s32 index) {
+    return msg->mainIndex == index;
+}
+
+s32 func_8009D274_jp(MessageWindow* msg) {
+    return mMsg_Check_main_index(msg, mMsg_INDEX_WAIT);
+}
+
+#ifdef NON_MATCHING
+s32 mMsg_Check_not_series_main_wait(MessageWindow* msg) {
+    return !(mMsg_Check_main_index(msg, mMsg_INDEX_WAIT) || mMsg_Check_main_index(msg, mMsg_INDEX_APPEAR_WAIT) ||
+             mMsg_Check_main_index(msg, mMsg_INDEX_DISAPPEAR_WAIT));
