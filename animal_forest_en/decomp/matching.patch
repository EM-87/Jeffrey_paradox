+        if (spaceFlag) {
+            while (dstIdx < len) {
+                data[dstIdx] = mMsg_CHAR_SPACE;
+                dstIdx++;
+            }
+        }
+    } else if (dstIdx > srcIdx) {
+        s32 growth = dstIdx - srcIdx;
+        s32 moveSize = len - srcIdx;
+
+        newLen += growth;
+        /* Too long: the text is not moved, but the length still grows and the
+         * caller still copies its string over what follows. */
+        if (newLen <= mMsg_MSG_SIZE_MAX) {
+            s32 i;
+            char* dstP = data + newLen - 1;
+            char* srcP = data + len - 1;
+
+            for (i = 0; i < moveSize; i++) {
+                *dstP-- = *srcP--;
+            }
+        }
+    }
+
+    return newLen;
+}
