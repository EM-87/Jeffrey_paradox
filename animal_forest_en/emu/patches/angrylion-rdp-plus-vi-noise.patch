--- a/src/core/n64video/vi.c
+++ b/src/core/n64video/vi.c
@@ -159,6 +159,13 @@ static void vi_process_full_parallel(uint32_t worker_id)
 
         struct n64video_pixel* pixel_row = &prescale[prescale_ptr + linecount * y];
 
+        /* animal_forest_en/emu: the gamma dither's noise from a seed fixed
+         * per line, so the picture depends only on RDRAM and the VI
