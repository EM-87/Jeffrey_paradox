diff --git a/src/backends/clock_ctime_plus_delta.c b/src/backends/clock_ctime_plus_delta.c
index f4b1492..eaa43e1 100644
--- a/src/backends/clock_ctime_plus_delta.c
+++ b/src/backends/clock_ctime_plus_delta.c
@@ -21,8 +21,32 @@
 
 #include "clock_ctime_plus_delta.h"
 
+#include "api/m64p_types.h"
+
 #include <time.h>
 
+/* Headless runs (animal_forest_en/emu): a clock that starts where the
+ * frontend says and advances with emulated time, 60 VIs to the second, so
+ * the same inputs see the same date on every run. */
+static long long l_fixed_clock_base = -1;
+unsigned int g_fixed_clock_vis;
+
+EXPORT void CALL HeadlessFixClock(long long base, unsigned int vis)
+{
+    l_fixed_clock_base = base;
+    g_fixed_clock_vis = vis;
+}
+
+int headless_clock_fixed(void)
+{
+    return l_fixed_clock_base >= 0;
+}
+
+EXPORT unsigned int CALL HeadlessClockVis(void)
+{
+    return g_fixed_clock_vis;
+}
+
 
 time_t ctime_plus_delta_get_time(void* clock)
 {
@@ -30,6 +54,9 @@ time_t ctime_plus_delta_get_time(void* clock)
         ? 0
         : *(time_t*)clock;
 
+    if (l_fixed_clock_base >= 0)
+        return user_delta + (time_t)(l_fixed_clock_base + g_fixed_clock_vis / 60);
+
     return user_delta + time(NULL);
 }
 
