+
+/* animal_forest_en/emu: the fixed clock's VI count and the frame number,
+ * kept in the spare room of the extra-state area. The RTC in the state
+ * remembers the time it last read; without the count it would jump on
+ * load. An unpatched core leaves these bytes zero and never reads them. */
+#define HEADLESS_STATE_MAGIC 0x484c434bu /* "HLCK" */
+extern unsigned int g_fixed_clock_vis;
+unsigned int headless_get_frame(void);
+void headless_set_frame(unsigned int frame);
 static const unsigned char pj64_magic[4] = { 0xC8, 0xA6, 0xD8, 0x23 };
 
 static savestates_job job = savestates_job_nothing;
@@ -877,6 +886,12 @@ static int savestates_load_m64p(struct device* dev, char *filepath)
             /* extra cp0 and cp2 state */
             *r4300_cp0_latch(&dev->r4300.cp0) = GETDATA(curr, uint64_t);
             *r4300_cp2_latch(&dev->r4300.cp2) = GETDATA(curr, uint64_t);
+
+            if (GETDATA(curr, uint32_t) == HEADLESS_STATE_MAGIC)
+            {
+                g_fixed_clock_vis = GETDATA(curr, uint32_t);
+                headless_set_frame(GETDATA(curr, uint32_t));
+            }
         }
     }
     else
@@ -1916,6 +1931,10 @@ static int savestates_save_m64p(const struct device* dev, char *filepath)
     PUTDATA(curr, uint64_t, *r4300_cp0_latch((struct cp0*)&dev->r4300.cp0));
     PUTDATA(curr, uint64_t, *r4300_cp2_latch((struct cp2*)&dev->r4300.cp2));
 
+    PUTDATA(curr, uint32_t, HEADLESS_STATE_MAGIC);
+    PUTDATA(curr, uint32_t, g_fixed_clock_vis);
+    PUTDATA(curr, uint32_t, headless_get_frame());
+
     init_work(&save->work, savestates_save_m64p_work);
     queue_work(&save->work);
 
